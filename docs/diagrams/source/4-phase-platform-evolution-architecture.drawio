        </mxCell>
        <mxCell id="l7" parent="1" style="text;html=1;align=right;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#94A3B8;" value="CONSUME" vertex="1">
          <mxGeometry height="60" width="170" x="150" y="1187" as="geometry" />
        </mxCell>
        <UserObject label="&lt;b&gt;Workday SOAP API&lt;/b&gt;" tooltip="Source: Workday Web Services. Incremental pulls by watermark (Updated_From / Updated_Through), configured in the YAML manifest." id="n1">
          <mxCell parent="1" style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=1.5;shadow=1;fontSize=13;" vertex="1">
            <mxGeometry height="60" width="320" x="380" y="150" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;Landing Zone&lt;/b&gt;&lt;br&gt;&lt;b&gt;ADLS:&lt;/b&gt; Raw XML / JSON, immutable" tooltip="Contract: payload exactly as received · append-only · partitioned by source/extraction_date · retained for replay · access: platform engineers only." id="n2">
          <mxCell parent="1" style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#E2E8F0;strokeColor=#64748B;strokeWidth=1.5;shadow=1;fontSize=12;" vertex="1">
            <mxGeometry height="60" width="320" x="380" y="270" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;Raw Zone&lt;/b&gt;&lt;br&gt;&lt;b&gt;Delta Lake:&lt;/b&gt; Source-aligned" tooltip="Contract: typed, flattened, deduplicated, source-aligned · schema validated against YAML expectations · rows that fail type casting go to a rejects table · no business logic." id="n3">
          <mxCell parent="1" style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#C2410C;strokeWidth=1.5;shadow=1;fontSize=12;" vertex="1">
            <mxGeometry height="60" width="320" x="380" y="390" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;Curated Zone&lt;/b&gt;&lt;br&gt;&lt;b&gt;Delta Lake:&lt;/b&gt; Kimball Star Schema" tooltip="Contract: conformed on person_id (MPI) · SCD Type 2 via MERGE, change detected by content compare · unknown member (SK = -1) instead of NULL foreign keys · DQ checks alert; a failed check stops the published snapshot from advancing · owned by the platform team." id="n4">
          <mxCell parent="1" style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#E5E7EB;strokeColor=#6B7280;strokeWidth=1.5;shadow=1;fontSize=12;" vertex="1">
            <mxGeometry height="60" width="320" x="380" y="510" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;Consumption Zone&lt;/b&gt;&lt;br&gt;&lt;b&gt;Delta Lake:&lt;/b&gt; Pre-aggregated" tooltip="Contract: purpose-built aggregates for dashboards · rebuilt daily · freshness target recorded as a product tag in the catalog." id="n5">
          <mxCell parent="1" style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#CA8A04;strokeWidth=1.5;shadow=1;fontSize=12;" vertex="1">
            <mxGeometry height="60" width="320" x="380" y="630" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;Published Snapshot&lt;/b&gt;&lt;br&gt;&lt;b&gt;Unity Catalog:&lt;/b&gt; Pinned to last checked versions" tooltip="Contract: views pinned to the last Delta versions that passed the checks, so every product reads one consistent set of versions · advanced only after checks pass · read by data products, not people." id="n6">
          <mxCell parent="1" style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=1.5;shadow=1;fontSize=12;" vertex="1">
            <mxGeometry height="60" width="320" x="380" y="750" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Domain Data Products&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal&quot;&gt;Views over published, masks + row filters per reader&lt;/font&gt;" tooltip="Each product is a schema of views over published. Masks and row filters are applied inside the views through governance functions (e.g. mask_email, mask_compensation, bu_filter). Domain groups get SELECT on their product schema only. See ADR-0011." id="dp">
          <mxCell parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#9333EA;strokeWidth=2;verticalAlign=top;fontSize=13;fontStyle=1;fontColor=#7E22CE;shadow=1;" vertex="1">
            <mxGeometry height="270" width="400" x="340" y="870" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p1" parent="1" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9333EA;fontSize=11;" value="Core Workforce &lt;font color=&quot;#7E22CE&quot;&gt;(dp_core_workforce)&lt;/font&gt;" vertex="1">
          <mxGeometry height="34" width="320" x="380" y="920" as="geometry" />
        </mxCell>
        <mxCell id="p2" parent="1" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9333EA;fontSize=11;" value="Compensation &lt;font color=&quot;#7E22CE&quot;&gt;(dp_comp)&lt;/font&gt;" vertex="1">
          <mxGeometry height="34" width="320" x="380" y="963" as="geometry" />
        </mxCell>
        <mxCell id="p3" parent="1" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9333EA;fontSize=11;" value="Talent Acquisition &lt;font color=&quot;#7E22CE&quot;&gt;(dp_talent_acquisition)&lt;/font&gt;" vertex="1">
          <mxGeometry height="34" width="320" x="380" y="1006" as="geometry" />
        </mxCell>
        <mxCell id="p4" parent="1" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9333EA;fontSize=11;" value="Learning and Development &lt;font color=&quot;#7E22CE&quot;&gt;(dp_learn)&lt;/font&gt;" vertex="1">
          <mxGeometry height="34" width="320" x="380" y="1049" as="geometry" />
        </mxCell>
        <mxCell id="p5" parent="1" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9333EA;fontSize=11;" value="Employee Experience &lt;font color=&quot;#7E22CE&quot;&gt;(dp_emp_experience)&lt;/font&gt;" vertex="1">
          <mxGeometry height="34" width="320" x="380" y="1092" as="geometry" />
        </mxCell>
        <mxCell id="n7" parent="1" style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#4F46E5;strokeWidth=1.5;shadow=1;fontSize=12;" value="&lt;b&gt;Tableau + Databricks SQL&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Analytics and self-service on dp_* views&lt;/font&gt;" vertex="1">
          <mxGeometry height="55" width="420" x="330" y="1190" as="geometry" />
        </mxCell>
        <mxCell id="n8" parent="1" style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#4F46E5;strokeWidth=1.5;shadow=1;fontSize=11;" value="&lt;b&gt;HRBP Portal + ServiceNow&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;via profile API&lt;/font&gt;" vertex="1">
          <mxGeometry height="55" width="230" x="780" y="1190" as="geometry" />
        </mxCell>
        <UserObject label="&lt;b&gt;Master Person Index&lt;/b&gt;&lt;br&gt;4-pass identity resolution → person_id" tooltip="Exact employee_id → email → fuzzy (name + hire_date + job_family) → manual review queue. Each pass only processes records the previous pass left unresolved. Click for the Phase 2 page." link="data:page/id,phase2" id="mpi">
          <mxCell parent="1" style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=1.5;fontSize=11;" vertex="1">
            <mxGeometry height="60" width="230" x="780" y="390" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="mdl" parent="1" style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontSize=11;align=left;spacingLeft=12;" value="• 14 dimensions (SCD Type 2)&lt;br&gt;• 15 fact tables&lt;br&gt;• Unknown member (SK = −1)" vertex="1">
          <mxGeometry height="60" width="230" x="780" y="510" as="geometry" />
        </mxCell>
        <UserObject label="&lt;b&gt;Real-time path&lt;/b&gt; (side branch)&lt;br&gt;Workday BPN → webhook (Redis dedup) → Event Hubs → Spark Structured Streaming → &lt;b&gt;Cosmos DB profile&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;Nightly profile rebuild from the published snapshot + reconciliation of later events&lt;/font&gt;" tooltip="At-least-once delivery with idempotent sinks keyed on event_id (newer event wins). Events are also archived to Delta (MERGE on event_id) and stored in Cassandra (interim; target: Delta event table). Click for the Phase 4 page." link="data:page/id,phase4" id="evt">
          <mxCell parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#7C3AED;strokeWidth=1.5;dashed=1;shadow=1;fontSize=10;align=left;spacingLeft=10;" vertex="1">
            <mxGeometry height="130" width="230" x="780" y="890" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Python extraction (zeep / requests, YAML manifest)" tooltip="The config-driven framework from Phase 1: one YAML manifest per API, incremental pulls by watermark. The watermark is saved only after landing succeeds, so a failed run re-extracts the same window. Click for Phase 1." link="data:page/id,phase1" id="f1">
          <mxCell edge="1" parent="1" source="n1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2563EB;strokeWidth=2;endArrow=blockThin;endFill=1;flowAnimation=1;fontSize=10;fontStyle=2;fontColor=#1D4ED8;labelBackgroundColor=#FFFFFF;" target="n2">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="PySpark: parse, flatten, cast, dedup" tooltip="XML/JSON is parsed into typed, source-aligned Delta tables. Duplicates are removed; rows that fail type casting go to a rejects table instead of failing the run. Click for Phase 4." link="data:page/id,phase4" id="f2">
          <mxCell edge="1" parent="1" source="n2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#16A34A;strokeWidth=2;endArrow=blockThin;endFill=1;flowAnimation=1;fontSize=10;fontStyle=2;fontColor=#15803D;labelBackgroundColor=#FFFFFF;" target="n3">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="PySpark: MPI, dimensional transforms, SCD Type 2" tooltip="Records are matched to one person_id, then loaded with MERGE INTO for SCD Type 2 (content compare) and unknown member for missing keys. DQ checks run here and alert. Click for Phase 2." link="data:page/id,phase2" id="f3">
          <mxCell edge="1" parent="1" source="n3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=2;endArrow=blockThin;endFill=1;flowAnimation=1;fontSize=10;fontStyle=2;fontColor=#334155;labelBackgroundColor=#FFFFFF;" target="n4">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="PySpark: aggregate, purpose-specific" tooltip="Aggregates built for dashboards and feeds, such as month-end headcount, rebuilt daily from curated. Click for Phase 4." link="data:page/id,phase4" id="f4">
          <mxCell edge="1" parent="1" source="n4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#CA8A04;strokeWidth=2;endArrow=blockThin;endFill=1;flowAnimation=1;fontSize=10;fontStyle=2;fontColor=#A16207;labelBackgroundColor=#FFFFFF;" target="n5">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="pin last checked versions (only if checks pass)" tooltip="The publish step records the Delta versions of every table that passed the checks and points the published views at them. If any check fails, the pointer stays on the previous good versions. Click for ADR-0010." link="https://github.com/srimarrivada/Enterprise-Data-Platform-Evolution-Reference-Architecture/blob/main/docs/adr/0010-delta-over-hive-parquet.md" id="f5">
          <mxCell edge="1" parent="1" source="n5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7C3AED;strokeWidth=2;endArrow=blockThin;endFill=1;flowAnimation=1;fontSize=10;fontStyle=2;fontColor=#6D28D9;labelBackgroundColor=#FFFFFF;" target="n6">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="views + governance functions" tooltip="Each domain product is a schema of views over published. Governance functions mask and filter per reader inside the views, so no data is copied (ADR-0011). Click for the ADRs." link="https://github.com/srimarrivada/Enterprise-Data-Platform-Evolution-Reference-Architecture/tree/main/docs/adr" id="f5b">
          <mxCell edge="1" parent="1" source="n6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9333EA;strokeWidth=2;endArrow=blockThin;endFill=1;flowAnimation=1;fontSize=10;fontStyle=2;fontColor=#7E22CE;labelBackgroundColor=#FFFFFF;" target="dp">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="SQL (masked + filtered per reader)" tooltip="Tableau and Databricks SQL query the dp_* views. Domain groups have SELECT on their product schema only; every read is in the audit log (ADR-0011). Click for the ADRs." link="https://github.com/srimarrivada/Enterprise-Data-Platform-Evolution-Reference-Architecture/tree/main/docs/adr" id="f6">
          <mxCell edge="1" parent="1" source="dp" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4F46E5;strokeWidth=2;endArrow=blockThin;endFill=1;flowAnimation=1;fontSize=10;fontStyle=2;fontColor=#4338CA;labelBackgroundColor=#FFFFFF;" target="n7">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" tooltip="Person records from Raw go through the 4 MPI passes; the resulting person_id conforms every dimension and fact. Click for Phase 2." link="data:page/id,phase2" id="f7">
          <mxCell edge="1" parent="1" source="n3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#EA580C;strokeWidth=1.5;dashed=1;endArrow=blockThin;endFill=1;flowAnimation=1;" target="mpi">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" tooltip="The curated model introduced in Phase 2: 14 SCD2 dimensions and 15 facts, with an unknown member row in every dimension. Click for Phase 2." link="data:page/id,phase2" id="f8">
          <mxCell edge="1" parent="1" source="n4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#94A3B8;strokeWidth=1.5;dashed=1;endArrow=blockThin;endFill=1;" target="mdl">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="profile API" tooltip="The HRBP portal and ServiceNow read one profile document per employee through an API over Cosmos DB, kept current by the stream between nightly rebuilds. Click for Phase 4." link="data:page/id,phase4" id="f9">
          <mxCell edge="1" parent="1" source="evt" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7C3AED;strokeWidth=2;endArrow=blockThin;endFill=1;flowAnimation=1;fontSize=10;fontStyle=2;fontColor=#6D28D9;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" target="n8">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="notes" parent="0" value="Annotations" />
        <UserObject label="REFERENCE ARCHITECTURE&lt;br&gt;Repository ↗" tooltip="Personal design exercise with a hands-on reference implementation. Click to open the repository." link="https://github.com/srimarrivada/Enterprise-Data-Platform-Evolution-Reference-Architecture" id="badge">
          <mxCell parent="notes" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#92400E;fontSize=11;fontStyle=1;" vertex="1">
            <mxGeometry height="60" width="190" x="870" y="20" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;✔ DQ checks&lt;/b&gt; · 9 types, YAML-configured&lt;br&gt;Phases 1–3: blocking gate before consumption&lt;br&gt;Phase 4: checks alert; a failure stops the published snapshot from advancing" tooltip="Check types: completeness, uniqueness, referential integrity, value range, freshness, SCD2 consistency, row-count variance, cross-layer reconciliation, distribution anomaly." id="dqg">
          <mxCell parent="notes" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#DC2626;dashed=1;fontSize=10;align=left;spacingLeft=10;" vertex="1">
            <mxGeometry height="80" width="230" x="780" y="740" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="foot" parent="notes" style="text;html=1;whiteSpace=wrap;align=center;fontSize=10;fontStyle=2;fontColor=#64748B;" value="Personal reference architecture; each zone tooltip states its data contract (format, mutability, quality check, owner). Hover an arrow to see what happens at that step; click it to open the related page or ADR." vertex="1">
          <mxGeometry height="30" width="820" x="140" y="1270" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
