          </mxCell>
        </UserObject>
        <mxCell id="d1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontColor=#334155;" value="Raw XML/JSON&lt;div&gt;Immutable&lt;/div&gt;&lt;div&gt;Partitioned by source/date&lt;/div&gt;" vertex="1">
          <mxGeometry height="50" width="394" x="411" y="575" as="geometry" />
        </mxCell>
        <UserObject label="RAW" tooltip="Contract: source-aligned Parquet, typed and flattened, deduplicated, no business logic. Schema expectations validated from YAML; rows that fail type casting go to a rejects table, not the raw table." id="z2">
          <mxCell parent="1" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#C2410C;strokeWidth=1.5;fontStyle=1;fontSize=12;fontColor=#1E293B;shadow=1;" vertex="1">
            <mxGeometry height="50" width="170" x="211" y="665" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="d2" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontColor=#334155;" value="Parquet&lt;div&gt;Source-aligned schemas (raw_workers_employment, raw_workers_compensation, ...)&lt;/div&gt;&lt;div&gt;Rejects quarantined&lt;/div&gt;" vertex="1">
          <mxGeometry height="50" width="394" x="411" y="665" as="geometry" />
        </mxCell>
        <UserObject label="CURATED" tooltip="Contract: Kimball star schema. 9 dimensions with SCD Type 2 (effective_from / effective_to / is_current, change detected by content compare), 8 fact tables. Unknown member (SK = -1) instead of NULL foreign keys. Blocking DQ gate: a failed check stops the load before consumption. Hive external tables." id="z3">
          <mxCell parent="1" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#E5E7EB;strokeColor=#6B7280;strokeWidth=1.5;fontStyle=1;fontSize=12;fontColor=#1E293B;shadow=1;" vertex="1">
            <mxGeometry height="50" width="170" x="211" y="755" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="d3" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontColor=#334155;" value="Parquet · Kimball star schema · Hive external tables&lt;div&gt;9 dims (SCD Type 2) / 8 facts · unknown member&lt;/div&gt;&lt;div&gt;&lt;b&gt;Blocking DQ gate&lt;/b&gt; before consumption&lt;/div&gt;" vertex="1">
          <mxGeometry height="50" width="394" x="411" y="755" as="geometry" />
        </mxCell>
        <UserObject label="CONSUMPTION" tooltip="Contract: purpose-built aggregates for dashboards and downstream feeds. Rebuilt daily." id="z4">
          <mxCell parent="1" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#CA8A04;strokeWidth=1.5;fontStyle=1;fontSize=12;fontColor=#1E293B;shadow=1;" vertex="1">
