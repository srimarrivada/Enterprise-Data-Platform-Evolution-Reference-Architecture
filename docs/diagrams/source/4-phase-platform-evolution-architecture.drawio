          <mxGeometry height="50" width="394" x="411" y="845" as="geometry" />
        </mxCell>
        <mxCell id="srv" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F0FDFA;strokeColor=#0D9488;verticalAlign=top;align=center;spacingLeft=12;spacingTop=4;fontSize=13;fontStyle=1;fontColor=#0F766E;" value="SERVING: Downstream Consumers" vertex="1">
          <mxGeometry height="120" width="760" x="90" y="960" as="geometry" />
