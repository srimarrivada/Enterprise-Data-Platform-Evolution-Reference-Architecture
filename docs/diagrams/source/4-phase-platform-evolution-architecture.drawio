        <mxCell id="v1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0D9488;strokeWidth=1.5;shadow=1;fontSize=11;fontColor=#1E293B;" value="&lt;b&gt;Tableau Server&lt;/b&gt;&lt;br&gt;Hive JDBC&lt;div&gt;HR dashboards&lt;/div&gt;" vertex="1">
          <mxGeometry height="60" width="220" x="115" y="1000" as="geometry" />
        </mxCell>
        <mxCell id="v2" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0D9488;strokeWidth=1.5;shadow=1;fontSize=11;fontColor=#1E293B;" value="&lt;b&gt;Downstream Systems&lt;/b&gt;&lt;div&gt;Existing feeds (batch export)&lt;/div&gt;" vertex="1">
          <mxGeometry height="60" width="220" x="360" y="1000" as="geometry" />
        </mxCell>
        <mxCell id="v3" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0D9488;strokeWidth=1.5;shadow=1;fontSize=11;fontColor=#1E293B;" value="&lt;b&gt;Hive Metastore&lt;/b&gt;&lt;br&gt;Relational backend&lt;div&gt;Table catalog&lt;/div&gt;" vertex="1">
          <mxGeometry height="60" width="220" x="605" y="1000" as="geometry" />
        </mxCell>
        <UserObject label="" tooltip="Incremental pulls by watermark (Updated_From / Updated_Through). Each API is one YAML manifest: adding an API needs no code change. Click for the ADRs." link="https://github.com/srimarrivada/Enterprise-Data-Platform-Evolution-Reference-Architecture/tree/main/docs/adr" id="e1">
          <mxCell edge="1" parent="1" source="src" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#334155;strokeWidth=2;endArrow=blockThin;endFill=1;flowAnimation=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" target="ext">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" tooltip="The payload is written to Landing exactly as received. The watermark is saved only after landing succeeds, so a failed run re-extracts the same window (at-least-once, idempotent). Click for the zone contracts." link="data:page/id,dataflow" id="e2">
          <mxCell edge="1" parent="1" source="ext" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#334155;strokeWidth=2;endArrow=blockThin;endFill=1;flowAnimation=1;exitX=0.271;exitY=1;entryX=0.5;entryY=0;" target="z1">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="PySpark (parse, flatten, type cast, dedup)" tooltip="XML/JSON is parsed and flattened into typed, source-aligned Parquet. Duplicates are removed; rows that fail type casting go to a rejects table. Click for the zone contracts." link="data:page/id,dataflow" id="e3">
          <mxCell edge="1" parent="1" source="z1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#334155;strokeWidth=2;endArrow=blockThin;endFill=1;flowAnimation=1;fontSize=10;fontColor=#475569;labelBackgroundColor=#EFF6FF;" target="z2">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="PySpark (dimensional transforms, SCD2, DQ checks)" tooltip="SCD Type 2 by content compare, unknown member (SK = -1) for missing keys. Blocking DQ checks run here: a failure stops the load before Consumption. Click for the zone contracts." link="data:page/id,dataflow" id="e4">
          <mxCell edge="1" parent="1" source="z2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#334155;strokeWidth=2;endArrow=blockThin;endFill=1;flowAnimation=1;fontSize=10;fontColor=#475569;labelBackgroundColor=#EFF6FF;" target="z3">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="PySpark (aggregate, purpose-specific)" tooltip="Aggregates built for each dashboard and feed, such as month-end headcount, rebuilt daily. Runs only after the DQ gate passes. Click for the zone contracts." link="data:page/id,dataflow" id="e5">
          <mxCell edge="1" parent="1" source="z3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#334155;strokeWidth=2;endArrow=blockThin;endFill=1;flowAnimation=1;fontSize=10;fontColor=#475569;labelBackgroundColor=#EFF6FF;" target="z4">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" tooltip="Tableau reads Hive tables over JDBC; existing downstream feeds receive batch exports. Phase 2 adds a MongoDB 360° profile. Click for Phase 2." link="data:page/id,phase2" id="e6">
          <mxCell edge="1" parent="1" source="z4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0D9488;strokeWidth=2;endArrow=blockThin;endFill=1;flowAnimation=1;exitX=0.5;exitY=1;entryX=0.271;entryY=0;" target="srv">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="orch" parent="0" value="Orchestration" />
        <mxCell id="ln5" parent="orch" style="text;html=1;horizontal=0;fontSize=9;fontStyle=1;fontColor=#94A3B8;align=center;verticalAlign=middle;" value="ORCHESTRATION" vertex="1">
          <mxGeometry height="80" width="30" x="40" y="1131" as="geometry" />
        </mxCell>
        <UserObject label="&lt;b&gt;ORCHESTRATION: Apache Airflow&lt;/b&gt;&lt;br&gt;DAGs generated from YAML | Dependencies inferred from configs | Daily 2:00 AM | Retries 3 | Resume from failed step | Teams alerts | SLA 5:30 AM (design target)" tooltip="DAGs are generated from the same YAML manifests: one extraction task group per source, then zone-transition Spark jobs, then refresh/export. Task dependencies are inferred from the configs, so code and DAGs cannot drift apart. Re-runs are idempotent (watermarks and run log)." id="air">
          <mxCell parent="orch" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=2;shadow=1;fontSize=11;fontColor=#7C2D12;" vertex="1">
            <mxGeometry height="80" width="760" x="90" y="1131" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="① Trigger Extraction&lt;div&gt;&lt;i&gt;(per YAML manifest)&lt;/i&gt;&lt;/div&gt;" tooltip="One extraction task group per source, generated from its YAML manifest. Retries 3 times; the watermark is saved only after landing. Click for the Phase 1 code." link="https://github.com/srimarrivada/Enterprise-Data-Platform-Evolution-Reference-Implementation/tree/main/phase1-batch-lake" id="o1">
          <mxCell edge="1" parent="orch" source="air" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;dashPattern=6 4;strokeColor=#EA580C;strokeWidth=1.5;endArrow=open;endFill=0;fontSize=10;fontColor=#C2410C;fontStyle=1;labelBackgroundColor=#FFFFFF;entryX=1;entryY=0.5;flowAnimation=1;" target="ext">
            <mxGeometry relative="1" x="0.3191" y="10" as="geometry">
              <mxPoint as="offset" />
              <Array as="points">
                <mxPoint x="920" y="1200" />
                <mxPoint x="920" y="400" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="② Run PySpark zone&lt;div&gt;jobs + DQ gate&lt;/div&gt;" tooltip="Landing → Raw → Curated → Consumption, in the order inferred from the configs. A failed blocking check stops the run; a re-run resumes from the failed step. Click for the Phase 1 code." link="https://github.com/srimarrivada/Enterprise-Data-Platform-Evolution-Reference-Implementation/tree/main/phase1-batch-lake" id="o2">
          <mxCell edge="1" parent="orch" source="air" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;dashPattern=6 4;strokeColor=#EA580C;strokeWidth=1.5;endArrow=open;endFill=0;fontSize=10;fontColor=#C2410C;fontStyle=1;labelBackgroundColor=#FFFFFF;entryX=1;entryY=0.5;">
            <mxGeometry relative="1" x="0.027" y="40" as="geometry">
              <mxPoint as="offset" />
              <Array as="points">
                <mxPoint x="900" y="1180" />
                <mxPoint x="900" y="725" />
              </Array>
              <mxPoint x="850" y="1155" as="sourcePoint" />
              <mxPoint x="850" y="725" as="targetPoint" />
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="③ Refresh Serving&lt;div&gt;+ Export&lt;/div&gt;" tooltip="Runs only after the zone jobs and DQ gate succeed: rebuilds the MongoDB profiles, refreshes Tableau and pushes new hires to ServiceNow. Click for the Phase 2 code." link="https://github.com/srimarrivada/Enterprise-Data-Platform-Evolution-Reference-Implementation/tree/main/phase2-multi-source" id="o3">
          <mxCell edge="1" parent="orch" source="air" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;dashPattern=6 4;strokeColor=#EA580C;strokeWidth=1.5;endArrow=open;endFill=0;fontSize=10;fontColor=#C2410C;fontStyle=1;labelBackgroundColor=#FFFFFF;entryX=1;entryY=0.5;flowAnimation=1;" target="srv">
            <mxGeometry relative="1" x="-0.2941" y="30" as="geometry">
              <mxPoint as="offset" />
              <Array as="points">
                <mxPoint x="870" y="1150" />
                <mxPoint x="870" y="1020" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <mxCell id="notes" parent="0" value="Annotations" />
        <UserObject label="REFERENCE ARCHITECTURE&amp;nbsp;↗" tooltip="Personal design exercise. Click to open the Phase 1 folder in the reference implementation repository." link="https://github.com/srimarrivada/Enterprise-Data-Platform-Evolution-Reference-Architecture/blob/main/docs/architecture/phase1-batch-lake.md" id="badge">
          <mxCell parent="notes" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#92400E;fontSize=11;fontStyle=1;" vertex="1">
