        <mxCell id="hr" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#E11D48;strokeWidth=1.5;shadow=1;fontSize=10;fontColor=#1E293B;" value="&lt;b&gt;HRBP Portal&lt;/b&gt;&lt;br&gt;Reads profile via REST API (backed by MongoDB)&lt;div&gt;Single page per employee&lt;/div&gt;" vertex="1">
          <mxGeometry height="50" width="230" x="110" y="1255" as="geometry" />
        </mxCell>
        <UserObject label="DATA QUALITY: YAML-configured | 9 Check Types | Blocking gate + post-batch suite" tooltip="Checks marked blocking in YAML run inside the zone job and stop the load before consumption (inherited from Phase 1). The full suite runs after the main batch and alerts by severity." id="dq">
          <mxCell parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#DC2626;verticalAlign=top;align=center;spacingLeft=12;spacingTop=4;fontSize=13;fontStyle=1;fontColor=#B91C1C;" vertex="1">
