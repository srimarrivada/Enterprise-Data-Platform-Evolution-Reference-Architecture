        </mxCell>
        <mxCell id="s4" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D97706;strokeWidth=1.5;shadow=1;fontSize=10;" value="&lt;b&gt;Workday Recruiting&lt;/b&gt;&lt;br&gt;RaaS + Custom Reports&lt;div&gt;(Batch)&lt;/div&gt;" vertex="1">
          <mxGeometry height="70" width="170" x="654" y="172" as="geometry" />
        </mxCell>
        <mxCell id="s5" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#7C3AED;strokeWidth=2;shadow=1;fontSize=10;" value="&lt;b&gt;Workday BPN&lt;/b&gt;&lt;br&gt;Real-time events&lt;div&gt;HTTPS POST (JSON)&lt;/div&gt;" vertex="1">
          <mxGeometry height="70" width="170" x="837" y="172" as="geometry" />
        </mxCell>
        <UserObject label="&lt;b&gt;EXTRACTION: Python Framework&lt;/b&gt;&lt;br&gt;Same config-driven framework as Phases 1–3 | 4 batch sources | now writes to ADLS Gen2 instead of HDFS" tooltip="Design decision: only the storage target in configuration changed (hdfs:// → abfss://). Shows the framework does not depend on the storage layer." id="ext">
          <mxCell parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#16A34A;strokeWidth=1.5;shadow=1;fontSize=11;fontColor=#14532D;" vertex="1">
            <mxGeometry height="70" width="740" x="90" y="313" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;Webhook Receiver&lt;/b&gt;&lt;br&gt;Managed Redis dedup&lt;br&gt;ack within 3 s" tooltip="Same receiver as Phase 3, now hosted in Azure. Redis (managed cache) drops most duplicate deliveries; idempotent sinks catch the rest. Produces to Event Hubs over the Kafka protocol." id="wh">
          <mxCell parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#7C3AED;strokeWidth=1.5;shadow=1;fontSize=10;fontColor=#1E293B;" vertex="1">
            <mxGeometry height="70" width="175" x="845" y="313" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="sto" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;verticalAlign=top;align=center;spacingLeft=12;spacingTop=4;fontSize=13;fontStyle=1;fontColor=#1D4ED8;" value="STORAGE: ADLS Gen2 + Delta Lake" vertex="1">
          <mxGeometry height="330" width="450" x="90" y="426" as="geometry" />
        </mxCell>
        <mxCell id="z1" parent="1" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#E2E8F0;strokeColor=#64748B;strokeWidth=1.5;fontStyle=1;fontSize=12;shadow=1;" value="LANDING" vertex="1">
          <mxGeometry height="46" width="150" x="110" y="473" as="geometry" />
        </mxCell>
        <mxCell id="d1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontColor=#334155;" value="Raw JSON / XML / CSV&lt;div&gt;Immutable, partitioned by source/date&lt;/div&gt;" vertex="1">
          <mxGeometry height="46" width="250" x="280" y="473" as="geometry" />
        </mxCell>
        <mxCell id="z2" parent="1" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#C2410C;strokeWidth=1.5;fontStyle=1;fontSize=12;shadow=1;" value="RAW" vertex="1">
          <mxGeometry height="46" width="150" x="110" y="543" as="geometry" />
        </mxCell>
        <mxCell id="d2" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontColor=#334155;" value="Delta, source-aligned&lt;div&gt;Dedup, rejects quarantined&lt;/div&gt;" vertex="1">
          <mxGeometry height="46" width="250" x="280" y="543" as="geometry" />
        </mxCell>
        <UserObject label="CURATED" tooltip="MERGE INTO for SCD Type 2 (close current row, insert new version; change detected by content compare). Unknown member (SK = -1) instead of NULL foreign keys. Z-ORDER on person_id + effective date. OPTIMIZE / VACUUM in the maintenance DAG. DQ checks alert; a failed check stops the published snapshot from advancing." id="z3">
          <mxCell parent="1" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#E5E7EB;strokeColor=#6B7280;strokeWidth=1.5;fontStyle=1;fontSize=12;shadow=1;" vertex="1">
            <mxGeometry height="46" width="150" x="110" y="613" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="d3" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontColor=#334155;" value="Delta, 14 dims / 15 facts&lt;div&gt;MERGE SCD2, ACID, Time travel, Z-ORDER&lt;/div&gt;&lt;div&gt;DQ checks (alerting)&lt;/div&gt;" vertex="1">
          <mxGeometry height="46" width="250" x="280" y="613" as="geometry" />
        </mxCell>
        <mxCell id="z4" parent="1" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#CA8A04;strokeWidth=1.5;fontStyle=1;fontSize=12;shadow=1;" value="CONSUMPTION" vertex="1">
          <mxGeometry height="46" width="150" x="110" y="683" as="geometry" />
        </mxCell>
        <mxCell id="d4" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontColor=#334155;" value="Delta, pre-aggregated&lt;div&gt;&lt;b&gt;Published snapshot&lt;/b&gt; pinned only after checks pass&lt;/div&gt;" vertex="1">
          <mxGeometry height="46" width="250" x="280" y="683" as="geometry" />
        </mxCell>
        <mxCell id="str" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#7C3AED;verticalAlign=top;align=center;spacingLeft=12;spacingTop=4;fontSize=13;fontStyle=1;fontColor=#6D28D9;" value="STREAMING: Real-time Event Pipeline" vertex="1">
          <mxGeometry height="330" width="450" x="570" y="426" as="geometry" />
        </mxCell>
        <UserObject label="&lt;b&gt;Azure Event Hubs&lt;/b&gt; (Kafka endpoint, Standard tier)&lt;br&gt;5 topics | 7-day retention&lt;br&gt;SASL_SSL | partition key = emp_id" tooltip="Design decision: the Kafka endpoint means Phase 3 producers and consumers move with connection settings only; no brokers to run. Order is kept per employee within a topic, not across topics. The design does not rely on idempotent producers; duplicates are handled by the sinks." id="eh">
          <mxCell parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7C3AED;strokeWidth=1.5;shadow=1;fontSize=10;" vertex="1">
            <mxGeometry height="100" width="400" x="595" y="465" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;Spark Structured Streaming&lt;/b&gt; (Databricks, always on)&lt;br&gt;30-second trigger | At-least-once | Idempotent sinks (event_id, newer event wins)&lt;br&gt;Writes to: Cosmos DB (profile) | Cassandra (event store, interim) | Delta (archive, MERGE on event_id)" tooltip="Same consumer as Phase 3 with new connection settings. Replays after failure do not double-apply events. Checkpoints in ADLS." id="ss">
          <mxCell parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7C3AED;strokeWidth=1.5;shadow=1;fontSize=10;" vertex="1">
            <mxGeometry height="120" width="400" x="595" y="605" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="gov" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FDF4FF;strokeColor=#A21CAF;verticalAlign=top;align=center;spacingLeft=12;spacingTop=4;fontSize=13;fontStyle=1;fontColor=#86198F;" value="GOVERNANCE: Unity Catalog (Catalog + Lineage + Masking + Audit)" vertex="1">
          <mxGeometry height="380" width="930" x="90" y="790" as="geometry" />
        </mxCell>
        <mxCell id="cat" parent="1" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C026D3;verticalAlign=top;align=center;spacingTop=4;fontSize=12;fontStyle=1;fontColor=#86198F;" value="CATALOG: workday_platform" vertex="1">
          <mxGeometry height="200" width="890" x="110" y="830" as="geometry" />
        </mxCell>
        <UserObject label="&lt;b&gt;curated · consumption · ops&lt;/b&gt;&lt;br&gt;(schemas)&lt;div&gt;14 dims · 15 facts&lt;br&gt;Platform engineers only&lt;/div&gt;" tooltip="Platform-managed. Domain teams have no direct access; they read through dp_* views." id="g1">
          <mxCell parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontSize=10;" vertex="1">
            <mxGeometry height="70" width="165" x="125" y="865" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;published&lt;/b&gt;&lt;br&gt;(schema)&lt;div&gt;Pinned to last checked snapshot&lt;br&gt;Read by products, not people&lt;/div&gt;" tooltip="Views pinned to the last Delta versions that passed the checks, so every product reads one consistent set of versions. Advanced only after checks pass." id="gP">
          <mxCell parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;fontSize=10;" vertex="1">
            <mxGeometry height="70" width="165" x="300" y="865" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;dp_core_workforce&lt;/b&gt;&lt;br&gt;(schema)&lt;div&gt;Views over published&lt;br&gt;All HR analysts&lt;/div&gt;" tooltip="Domain data product: views over published with business-friendly names, descriptions and owners. Masks and row filters applied inside the views. GRANT SELECT to the HR analysts group." id="g2">
          <mxCell parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontSize=10;" vertex="1">
            <mxGeometry height="70" width="165" x="475" y="865" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;dp_comp&lt;/b&gt;&lt;br&gt;(schema)&lt;div&gt;Views over published&lt;br&gt;Compensation team&lt;/div&gt;" tooltip="Compensation values are masked inside the view (mask_compensation) for anyone outside the compensation group." id="g3">
          <mxCell parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontSize=10;" vertex="1">
            <mxGeometry height="70" width="165" x="650" y="865" as="geometry" />
          </mxCell>
        </UserObject>
