        <mxCell id="c2" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4F46E5;strokeWidth=1.5;shadow=1;fontSize=10;" value="&lt;b&gt;Databricks SQL Warehouse&lt;/b&gt;&lt;br&gt;Self-service queries by domain teams&lt;br&gt;Masked and filtered per reader" vertex="1">
          <mxGeometry height="100" width="280" x="420" y="1435" as="geometry" />
        </mxCell>
        <mxCell id="c3" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4F46E5;strokeWidth=1.5;shadow=1;fontSize=10;" value="&lt;b&gt;HRBP Portal + ServiceNow&lt;/b&gt;&lt;br&gt;Real-time employee profile&lt;br&gt;via profile API (Cosmos DB)" vertex="1">
          <mxGeometry height="100" width="280" x="725" y="1435" as="geometry" />
        </mxCell>
        <UserObject label="" tooltip="The same four batch sources as Phases 2–3. Only the storage target in the YAML changed (hdfs:// → abfss://); extraction code is unchanged. Click for the ADRs." link="https://github.com/srimarrivada/Enterprise-Data-Platform-Evolution-Reference-Architecture/tree/main/docs/adr" id="e1">
          <mxCell edge="1" parent="1" source="src" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#334155;strokeWidth=2;endArrow=blockThin;endFill=1;flowAnimation=1;exitX=0.398;exitY=1;entryX=0.5;entryY=0;" target="ext">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Batch path" tooltip="Payloads land in ADLS Gen2 exactly as received, partitioned by source and date. The watermark is saved only after landing succeeds. Click for the zone contracts." link="data:page/id,dataflow" id="e2">
          <mxCell edge="1" parent="1" source="ext" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#334155;strokeWidth=2;endArrow=blockThin;endFill=1;flowAnimation=1;fontSize=10;fontStyle=1;fontColor=#334155;labelBackgroundColor=#FFFFFF;exitX=0.315;exitY=1;entryX=0.517;entryY=0;" target="sto">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" tooltip="Workday pushes events over HTTPS with OAuth 2.0 and retries on timeout. The receiver acknowledges within 3 s and drops most duplicates with managed Redis. Click for ADR-0008." link="https://github.com/srimarrivada/Enterprise-Data-Platform-Evolution-Reference-Architecture/blob/main/docs/adr/0008-webhook-dedup-redis.md" id="e3a">
          <mxCell edge="1" parent="1" source="s5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7C3AED;strokeWidth=2;endArrow=blockThin;endFill=1;flowAnimation=1;exitX=0.5;exitY=1;entryX=0.44;entryY=0;" target="wh">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Event path (Kafka protocol)" tooltip="The receiver produces to Event Hubs through its Kafka endpoint: connection and SASL_SSL settings changed, producer code did not (ADR-0012). Click for the ADRs." link="https://github.com/srimarrivada/Enterprise-Data-Platform-Evolution-Reference-Architecture/tree/main/docs/adr" id="e3">
          <mxCell edge="1" parent="1" source="wh" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7C3AED;strokeWidth=2;endArrow=blockThin;endFill=1;flowAnimation=1;fontSize=10;fontStyle=1;fontColor=#6D28D9;labelBackgroundColor=#FFFFFF;exitX=0.44;exitY=1;entryX=0.8175;entryY=0;" target="eh">
            <mxGeometry relative="1" x="-0.3415" y="8" as="geometry">
              <mxPoint as="offset" />
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="" tooltip="Parse, flatten, type cast and dedup into source-aligned Delta tables; rows that fail type casting go to a rejects table. Click for the zone contracts." link="data:page/id,dataflow" id="e4">
          <mxCell edge="1" parent="1" source="z1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#334155;strokeWidth=1.5;endArrow=blockThin;endFill=1;flowAnimation=1;" target="z2">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" tooltip="MPI, then SCD Type 2 with MERGE INTO (change detected by content compare) and unknown member for missing keys. DQ checks alert here instead of blocking. Click for the zone contracts." link="data:page/id,dataflow" id="e5">
          <mxCell edge="1" parent="1" source="z2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#334155;strokeWidth=1.5;endArrow=blockThin;endFill=1;flowAnimation=1;" target="z3">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" tooltip="Aggregates are rebuilt daily. The published snapshot advances only when checks pass, so a bad run never reaches the data products. Click for ADR-0010." link="https://github.com/srimarrivada/Enterprise-Data-Platform-Evolution-Reference-Architecture/blob/main/docs/adr/0010-delta-over-hive-parquet.md" id="e6">
          <mxCell edge="1" parent="1" source="z3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#334155;strokeWidth=1.5;endArrow=blockThin;endFill=1;flowAnimation=1;" target="z4">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" tooltip="Same Structured Streaming consumer as Phase 3 with new connection settings: at-least-once, idempotent sinks keyed on event_id, checkpoints in ADLS. Click for the Phase 4 code." link="https://github.com/srimarrivada/Enterprise-Data-Platform-Evolution-Reference-Implementation/tree/main/phase4-azure-lakehouse" id="e7">
          <mxCell edge="1" parent="1" source="eh" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7C3AED;strokeWidth=2;endArrow=blockThin;endFill=1;flowAnimation=1;" target="ss">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Batch → Governed" tooltip="Curated and consumption Delta tables are registered in Unity Catalog. The published schema pins the last checked versions, and the product views read from it. Click for ADR-0010." link="https://github.com/srimarrivada/Enterprise-Data-Platform-Evolution-Reference-Architecture/blob/main/docs/adr/0010-delta-over-hive-parquet.md" id="e8">
          <mxCell edge="1" parent="1" source="sto" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#334155;strokeWidth=2;endArrow=blockThin;endFill=1;flowAnimation=1;fontSize=10;fontColor=#475569;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.242;entryY=0;" target="gov">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Event archive → Governed" tooltip="The Delta event archive (MERGE on event_id) is registered in Unity Catalog for lineage and SQL access. The stream also writes directly to Cosmos DB and Cassandra; those writes aren&#39;t drawn, to keep the governance lane clear. Click for the Phase 4 code." link="https://github.com/srimarrivada/Enterprise-Data-Platform-Evolution-Reference-Implementation/tree/main/phase4-azure-lakehouse" id="e9">
          <mxCell edge="1" parent="1" source="str" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7C3AED;strokeWidth=2;endArrow=blockThin;endFill=1;flowAnimation=1;fontSize=10;fontColor=#6D28D9;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.758;entryY=0;" target="gov">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Profile rebuild + reconciliation" tooltip="The nightly profile rebuild from the published snapshot sets the floor; reconciliation then re-applies events newer than the watermark to Cosmos DB. Same logic as Phase 3. Click for Phase 3." link="data:page/id,phase3" id="e10">
          <mxCell edge="1" parent="1" source="gov" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0D9488;strokeWidth=2;endArrow=blockThin;endFill=1;flowAnimation=1;fontSize=10;fontColor=#0F766E;labelBackgroundColor=#F0FDFA;exitX=0.296;exitY=1;entryX=0.5;entryY=0;" target="cos">
            <mxGeometry relative="1" x="-0.4687" y="5" as="geometry">
              <mxPoint as="offset" />
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="Delta / SQL (BI)" tooltip="Tableau connects through Databricks SQL to the dp_* product views; masks and row filters are applied per reader (ADR-0011). Click for the ADRs." link="https://github.com/srimarrivada/Enterprise-Data-Platform-Evolution-Reference-Architecture/tree/main/docs/adr" id="e12">
          <mxCell edge="1" parent="1" source="gov" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4F46E5;strokeWidth=2;endArrow=blockThin;endFill=1;flowAnimation=1;fontSize=10;fontColor=#4338CA;labelBackgroundColor=#F0FDFA;exitX=0.0645;exitY=1;entryX=0.125;entryY=0;" target="c1">
            <mxGeometry relative="1" x="0.5849" y="10" as="geometry">
              <mxPoint as="offset" />
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="" tooltip="The HRBP portal and ServiceNow read the profile API over Cosmos DB; the ops dashboard reads recent events from Cassandra (interim). Click for the Phase 4 code." link="https://github.com/srimarrivada/Enterprise-Data-Platform-Evolution-Reference-Implementation/tree/main/phase4-azure-lakehouse" id="e13">
          <mxCell edge="1" parent="1" source="srv" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0D9488;strokeWidth=2;endArrow=blockThin;endFill=1;flowAnimation=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" target="con">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="orch" parent="0" value="Orchestration" />
        <UserObject label="&lt;b&gt;ORCHESTRATION: Apache Airflow (managed)&lt;/b&gt;&lt;br&gt;DAGs generated from YAML | Dependencies inferred from configs | Daily 2:00 AM | Retries 3 | Resume from failed step&lt;br&gt;Batch + DQ + publish + reconciliation + Delta maintenance (OPTIMIZE / VACUUM) | Teams + ServiceNow alerts | SLA 5:30 AM (design target)" tooltip="Airflow triggers Databricks jobs for batch, publish and reconciliation. It does not run the stream: the streaming job runs continuously on Databricks, and Airflow only checks its health and consumer lag. Re-runs are idempotent (watermarks and run log)." id="air">
          <mxCell parent="orch" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=2;shadow=1;fontSize=11;fontColor=#7C2D12;" vertex="1">
            <mxGeometry height="80" width="930" x="90" y="1590" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="① Trigger Extraction" tooltip="One extraction task group per source, generated from the YAML manifests, now landing in ADLS. Retries 3 times; the watermark is saved only after landing. Click for the Phase 4 code." link="https://github.com/srimarrivada/Enterprise-Data-Platform-Evolution-Reference-Implementation/tree/main/phase4-azure-lakehouse" id="o1">
          <mxCell edge="1" parent="orch" source="air" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;dashPattern=6 4;strokeColor=#EA580C;strokeWidth=1.5;endArrow=open;endFill=0;fontSize=10;fontColor=#C2410C;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.75;entryX=0;entryY=0.5;" target="ext">
            <mxGeometry relative="1" x="0.8669" y="-40" as="geometry">
              <mxPoint as="offset" />
              <Array as="points">
                <mxPoint x="50" y="1650" />
                <mxPoint x="50" y="348" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="② Run Databricks Jobs (Zones)&lt;div&gt;+ DQ Checks&lt;/div&gt;" tooltip="Airflow triggers Databricks jobs for Landing → Raw → Curated → Consumption in the order inferred from the configs. DQ checks run and alert; a re-run resumes from the failed step. Click for the Phase 4 code." link="https://github.com/srimarrivada/Enterprise-Data-Platform-Evolution-Reference-Implementation/tree/main/phase4-azure-lakehouse" id="o2">
          <mxCell edge="1" parent="orch" source="air" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;dashPattern=6 4;strokeColor=#EA580C;strokeWidth=1.5;endArrow=open;endFill=0;fontSize=10;fontColor=#C2410C;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.35;entryX=0;entryY=0.5;" target="sto">
            <mxGeometry relative="1" x="0.627" y="-60" as="geometry">
              <mxPoint as="offset" />
              <Array as="points">
                <mxPoint x="70" y="1618" />
                <mxPoint x="70" y="591" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="③ Publish Snapshot&lt;div&gt;+ Reconciliation&lt;/div&gt;" tooltip="Publish advances the pinned snapshot only if all checks passed. Reconciliation then re-applies events newer than the watermark to Cosmos DB and alerts on differences. Click for the Phase 4 code." link="https://github.com/srimarrivada/Enterprise-Data-Platform-Evolution-Reference-Implementation/tree/main/phase4-azure-lakehouse" id="o3">
          <mxCell edge="1" parent="orch" source="air" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;dashPattern=6 4;strokeColor=#EA580C;strokeWidth=1.5;endArrow=open;endFill=0;fontSize=10;fontColor=#C2410C;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.35;entryX=1;entryY=0.5;" target="gov">
            <mxGeometry relative="1" x="0.3215" y="40" as="geometry">
              <mxPoint as="offset" />
              <Array as="points">
                <mxPoint x="1040" y="1618" />
                <mxPoint x="1040" y="980" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="④ Refresh Consumption" tooltip="Refreshes Tableau extracts and downstream exports from the newly published snapshot. The profile is already kept current by the stream. Click for the Phase 4 code." link="https://github.com/srimarrivada/Enterprise-Data-Platform-Evolution-Reference-Implementation/tree/main/phase4-azure-lakehouse" id="o4">
          <mxCell edge="1" parent="orch" source="air" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;dashPattern=6 4;strokeColor=#EA580C;strokeWidth=1.5;endArrow=open;endFill=0;fontSize=10;fontColor=#C2410C;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" target="con">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="⑤ Monitor Stream Health&lt;div&gt;+ Lag (always on)&lt;/div&gt;" tooltip="A sensor checks that the streaming job is running and that consumer lag stays within the threshold. Airflow does not start or stop the stream; it only alerts. Click for the Phase 4 code." link="https://github.com/srimarrivada/Enterprise-Data-Platform-Evolution-Reference-Implementation/tree/main/phase4-azure-lakehouse" id="o5">
          <mxCell edge="1" parent="orch" source="air" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;dashPattern=6 4;strokeColor=#EA580C;strokeWidth=1.5;endArrow=open;endFill=0;fontSize=10;fontColor=#C2410C;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.75;entryX=1;entryY=0.5;" target="str">
            <mxGeometry relative="1" x="0.6155" y="50" as="geometry">
              <mxPoint as="offset" />
              <Array as="points">
                <mxPoint x="1060" y="1650" />
                <mxPoint x="1060" y="591" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <mxCell id="notes" parent="0" value="Annotations" />
        <UserObject label="REFERENCE ARCHITECTURE&amp;nbsp;↗" tooltip="Personal design exercise. Click to open the Phase 4 folder (Databricks + Terraform + Unity Catalog) in the reference implementation repository." link="https://github.com/srimarrivada/Enterprise-Data-Platform-Evolution-Reference-Architecture/blob/main/docs/architecture/phase4-lakehouse.md" id="badge">
          <mxCell parent="notes" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#92400E;fontSize=11;fontStyle=1;" vertex="1">
            <mxGeometry height="60" width="190" x="870" y="20" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="targets" parent="notes" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;dashed=1;fontSize=10;fontColor=#78350F;spacing=6;" value="&lt;b&gt;DESIGN TARGETS&lt;/b&gt; (hypotheses, not measured results): 200+ analysts self-serve via domain products | 65% reduction in report-request backlog | 30–35% infrastructure cost reduction vs on-prem.&lt;br&gt;The reference implementation measures latency, runtimes and row counts; business outcomes are not measured." vertex="1">
          <mxGeometry height="50" width="990" x="60" y="1710" as="geometry" />
        </mxCell>
        <mxCell id="legend" parent="notes" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;dashed=1;fontSize=10;fontColor=#334155;" value="&lt;b&gt;LEGEND&lt;/b&gt;   &lt;font color=&quot;#334155&quot;&gt;━━▶&lt;/font&gt; Batch flow   &lt;font color=&quot;#7C3AED&quot;&gt;━━▶&lt;/font&gt; Stream   &lt;font color=&quot;#0D9488&quot;&gt;━━▶&lt;/font&gt; Serving   &lt;font color=&quot;#4F46E5&quot;&gt;━━▶&lt;/font&gt; BI / SQL   &lt;font color=&quot;#EA580C&quot;&gt;╍╍▶&lt;/font&gt; Orchestration (①–⑤)   &lt;font color=&quot;#0284C7&quot;&gt;┅┅&lt;/font&gt; Azure boundary   Dashed box = interim · Hover boxes and arrows for details; click arrows to open · Ctrl+Shift+L toggles layers" vertex="1">
          <mxGeometry height="40" width="990" x="60" y="1775" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="dataflow" name="5. End-to-End Data Flow">
