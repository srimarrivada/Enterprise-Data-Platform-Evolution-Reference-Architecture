        <UserObject label="&lt;b&gt;MongoDB · 360° profile&lt;/b&gt;&lt;br&gt;1 document per employee&lt;div&gt;&lt;br&gt;&lt;b&gt;Sections:&lt;/b&gt; Employment, Compensation, Performance, Training, Engagement, Manager, Org Context&lt;br&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;3-node replica set&lt;/div&gt;" tooltip="Document model chosen so the HRBP portal needs a single read per page. Rebuilt from curated after each batch." id="v1">
          <mxCell parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0D9488;strokeWidth=1.5;shadow=1;fontSize=10;fontColor=#1E293B;" vertex="1">
