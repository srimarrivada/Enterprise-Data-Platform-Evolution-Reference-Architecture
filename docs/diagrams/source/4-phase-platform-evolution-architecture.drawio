        <UserObject label="REFERENCE ARCHITECTURE&amp;nbsp;↗" tooltip="Personal design exercise. Click to open the Phase 2 folder in the reference implementation repository." link="https://github.com/srimarrivada/Enterprise-Data-Platform-Evolution-Reference-Architecture/blob/main/docs/architecture/phase2-multi-source.md" id="badge">
          <mxCell parent="notes" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#92400E;fontSize=11;fontStyle=1;" vertex="1">
