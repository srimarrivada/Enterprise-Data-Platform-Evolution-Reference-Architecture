        <mxCell id="c1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4F46E5;strokeWidth=1.5;shadow=1;fontSize=10;" value="&lt;b&gt;Tableau Server&lt;/b&gt;&lt;br&gt;Historical analytics dashboards&lt;br&gt;via Databricks SQL on dp_* views" vertex="1">
