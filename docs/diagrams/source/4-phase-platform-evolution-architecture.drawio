            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" tooltip="No on-prem hardware; cost follows compute autoscaling and the tier chosen for each managed service. Savings are a design hypothesis, not a measured result. Click for Phase 4." link="data:page/id,phase4" id="r8e3">
