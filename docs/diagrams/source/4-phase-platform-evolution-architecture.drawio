        </mxCell>
        <UserObject label="" tooltip="Four sources, one framework: each source is a YAML manifest. Only the survey feed needed a new protocol plugin (SFTP via Paramiko). Click for the ADRs." link="https://github.com/srimarrivada/Enterprise-Data-Platform-Evolution-Reference-Architecture/tree/main/docs/adr" id="e1">
          <mxCell edge="1" parent="1" source="src" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#334155;strokeWidth=2;endArrow=blockThin;endFill=1;flowAnimation=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" target="ext">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" tooltip="XML, JSON and CSV are written to Landing exactly as received, partitioned by source and extraction date. The watermark is saved only after landing succeeds. Click for the zone contracts." link="data:page/id,dataflow" id="e2">
          <mxCell edge="1" parent="1" source="ext" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#334155;strokeWidth=2;endArrow=blockThin;endFill=1;flowAnimation=1;exitX=0.164;exitY=1;entryX=0.5;entryY=0;" target="z1">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="PySpark: parse, flatten, cast, standardize dates, dedup" tooltip="Each source is parsed into typed, source-aligned Parquet. Date formats are standardized across sources, duplicates removed, and rows that fail type casting go to a rejects table. Click for the zone contracts." link="data:page/id,dataflow" id="e3">
          <mxCell edge="1" parent="1" source="z1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#334155;strokeWidth=2;endArrow=blockThin;endFill=1;flowAnimation=1;fontSize=10;fontColor=#475569;labelBackgroundColor=#EFF6FF;" target="z2">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" tooltip="Person records from all four sources enter the Master Person Index. Each pass only handles records the previous pass left unresolved; whatever is left goes to the manual review queue. Click for the Phase 2 code." link="https://github.com/srimarrivada/Enterprise-Data-Platform-Evolution-Reference-Implementation/tree/main/phase2-multi-source" id="e4">
          <mxCell edge="1" parent="1" source="z2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#334155;strokeWidth=2;endArrow=blockThin;endFill=1;flowAnimation=1;exitX=0.5;exitY=1;entryX=0.202;entryY=0;" target="mpi">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="PySpark: dimensional transforms, SCD2, blocking DQ gate" tooltip="Dimensions and facts are conformed on person_id. SCD Type 2 by content compare, unknown member (SK = -1) for missing keys. Blocking checks run here: a failure stops the load before Consumption. Click for the zone contracts." link="data:page/id,dataflow" id="e5">
          <mxCell edge="1" parent="1" source="mpi" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#334155;strokeWidth=2;endArrow=blockThin;endFill=1;flowAnimation=1;fontSize=10;fontColor=#475569;labelBackgroundColor=#EFF6FF;exitX=0.202;exitY=1;entryX=0.5;entryY=0;" target="z3">
            <mxGeometry relative="1" x="0.0057" y="55" as="geometry">
              <mxPoint y="-3" as="offset" />
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="PySpark: aggregate" tooltip="Purpose-built aggregates for dashboards and the portal, rebuilt daily. Runs only after the DQ gate passes. Click for the zone contracts." link="data:page/id,dataflow" id="e6">
          <mxCell edge="1" parent="1" source="z3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#334155;strokeWidth=2;endArrow=blockThin;endFill=1;flowAnimation=1;fontSize=10;fontColor=#475569;labelBackgroundColor=#EFF6FF;" target="z4">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="s4" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D97706;strokeWidth=1.5;shadow=1;fontSize=11;fontColor=#1E293B;" value="&lt;b&gt;Workday Recruiting&lt;/b&gt;&lt;div&gt;1 RaaS Report&lt;/div&gt;&lt;div&gt;2 Custom Reports&lt;/div&gt;" vertex="1">
          <mxGeometry height="70" width="170" x="665" y="175" as="geometry" />
        </mxCell>
        <mxCell id="x4" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=1.5;shadow=1;fontSize=11;fontColor=#1E293B;" value="&lt;b&gt;Requests + OAuth 2.0&lt;/b&gt;&lt;br&gt;(REST / RaaS)" vertex="1">
          <mxGeometry height="55" width="170" x="665" y="325" as="geometry" />
        </mxCell>
        <UserObject label="&lt;b&gt;Master Person Index · 4-pass identity resolution&lt;/b&gt;&lt;br&gt;Pass 1: Exact employee_id match (~95%)&lt;br&gt;Pass 2: Email match (~3%)&lt;br&gt;Pass 3: Fuzzy name + hire_date + job_family (~1.5%)&lt;br&gt;Pass 4: Manual review queue (~0.5%)" tooltip="Match-rate percentages are expected distributions (design assumptions), to be measured on synthetic data with injected duplicates. Each pass only processes records unresolved by the previous pass." id="mpi">
          <mxCell parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=1.5;shadow=1;fontSize=10;fontColor=#1E293B;align=left;spacingLeft=10;" vertex="1">
