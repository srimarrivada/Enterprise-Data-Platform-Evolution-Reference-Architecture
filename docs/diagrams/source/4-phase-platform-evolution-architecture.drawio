        <mxCell id="qr" parent="1" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fontColor=#7F1D1D;" value="Results → MongoDB. &lt;b&gt;Critical&lt;/b&gt; → ServiceNow incident. &lt;b&gt;Warning&lt;/b&gt; → Teams channel" vertex="1">
