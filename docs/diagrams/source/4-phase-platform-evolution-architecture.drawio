        <UserObject label="" tooltip="HTTPS POST with OAuth 2.0, acknowledged within 3 s. Redis drops most duplicate deliveries; idempotent sinks catch the rest. Click for ADR-0008." link="https://github.com/srimarrivada/Enterprise-Data-Platform-Evolution-Reference-Architecture/blob/main/docs/adr/0008-webhook-dedup-redis.md" id="c3e1">
          <mxCell edge="1" parent="1" source="c3a" style="endArrow=blockThin;endFill=1;strokeColor=#E11D48;strokeWidth=1.5;html=1;flowAnimation=1;" target="c3b">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="ExpressRoute" tooltip="Private link from on-prem Kafka to Spark Structured Streaming on Databricks in Azure. At-least-once delivery with idempotent sinks keyed on event_id. Click for Phase 3." link="data:page/id,phase3" id="c3e2">
          <mxCell edge="1" parent="1" source="c3b" style="endArrow=blockThin;endFill=1;strokeColor=#E11D48;strokeWidth=1.5;html=1;flowAnimation=1;fontSize=9;fontStyle=1;fontColor=#1D4ED8;labelBackgroundColor=none;" target="c3c">
            <mxGeometry relative="1" as="geometry">
              <mxPoint x="42" as="offset" />
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="" tooltip="Batch stays the source of truth. After each batch, reconciliation re-applies events newer than the extraction watermark and checks the result. Click for Phase 3." link="data:page/id,phase3" id="c3e3">
          <mxCell edge="1" parent="1" source="c3c" style="endArrow=blockThin;endFill=1;strokeColor=#E11D48;strokeWidth=1.5;html=1;flowAnimation=1;" target="c3d">
