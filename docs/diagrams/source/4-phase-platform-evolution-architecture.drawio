          <mxGeometry height="400" width="760" x="90" y="530" as="geometry" />
        </mxCell>
        <UserObject label="LANDING" tooltip="Contract: raw payload as received. Immutable, append-only. Partitioned by source/extraction_date. Enables full replay." id="z1">
          <mxCell parent="1" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#E2E8F0;strokeColor=#64748B;strokeWidth=1.5;fontStyle=1;fontSize=12;fontColor=#1E293B;shadow=1;" vertex="1">
