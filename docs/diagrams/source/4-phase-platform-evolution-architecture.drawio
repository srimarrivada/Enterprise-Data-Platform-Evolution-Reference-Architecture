        <mxCell id="s2" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D97706;strokeWidth=1.5;shadow=1;fontSize=10;" value="&lt;b&gt;Learning Platform&lt;/b&gt;&lt;br&gt;REST API&lt;div&gt;(Batch)&lt;/div&gt;" vertex="1">
