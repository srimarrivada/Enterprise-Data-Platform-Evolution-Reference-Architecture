        <mxCell id="q2" parent="1" style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DC2626;fontSize=10;" value="&lt;b&gt;Uniqueness&lt;/b&gt;&lt;br&gt;key uniqueness" vertex="1">
