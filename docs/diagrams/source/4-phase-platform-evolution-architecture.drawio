        <mxCell id="c4o" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#334155;" value="&lt;b&gt;Target outcomes&lt;/b&gt;&lt;br&gt;• Cloud-native, managed services&lt;br&gt;• Domain-owned data products&lt;br&gt;• Enterprise governance&lt;br&gt;• Self-service analytics" vertex="1">
          <mxGeometry height="90" width="210" x="852" y="518" as="geometry" />
        </mxCell>
        <UserObject label="" tooltip="Managed services that speak the same wire protocols (Kafka, MongoDB, Redis): connection settings change, client code does not (ADR-0012). Click for Phase 4." link="data:page/id,phase4" id="c4e1">
          <mxCell edge="1" parent="1" source="c4a" style="endArrow=blockThin;endFill=1;strokeColor=#9333EA;strokeWidth=1.5;html=1;flowAnimation=1;" target="c4b">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" tooltip="Delta tables registered in Unity Catalog. The published snapshot is pinned to the last checked versions and advances only when checks pass. Click for Phase 4." link="data:page/id,phase4" id="c4e2">
          <mxCell edge="1" parent="1" source="c4b" style="endArrow=blockThin;endFill=1;strokeColor=#9333EA;strokeWidth=1.5;html=1;flowAnimation=1;" target="c4c">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" tooltip="Analysts query product views over the published snapshot, masked and filtered per reader. The portal and ServiceNow read the profile API (Cosmos DB). Click for Phase 4." link="data:page/id,phase4" id="c4e3">
          <mxCell edge="1" parent="1" source="c4c" style="endArrow=blockThin;endFill=1;strokeColor=#9333EA;strokeWidth=1.5;html=1;flowAnimation=1;" target="c4d">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" tooltip="Phase 1 → 2: same extraction framework; adds 3 sources, the Master Person Index, the DQ framework and the MongoDB 360° profile. Click for Phase 2." link="data:page/id,phase2" id="cc1">
          <mxCell edge="1" parent="1" source="col1" style="endArrow=block;endFill=1;strokeWidth=4;strokeColor=#94A3B8;html=1;flowAnimation=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="col2">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" tooltip="Phase 2 → 3: adds a real-time speed layer in Azure over ExpressRoute. Batch stays on-prem as the source of truth; reconciliation keeps the two consistent. Click for Phase 3." link="data:page/id,phase3" id="cc2">
          <mxCell edge="1" parent="1" source="col2" style="endArrow=block;endFill=1;strokeWidth=4;strokeColor=#94A3B8;html=1;flowAnimation=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="col3">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" tooltip="Phase 3 → 4: moves to Azure managed services. Delta Lake replaces Hive/Parquet, and Unity Catalog adds governed domain data products. Cassandra stays self-managed until replaced. Click for Phase 4." link="data:page/id,phase4" id="cc3">
