        <mxCell id="facts" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontSize=9;fontColor=#1E293B;align=left;verticalAlign=top;spacing=6;" value="&lt;b&gt;15 FACTS&lt;/b&gt;&lt;br&gt;headcount_daily, headcount_monthly, compensation_event, worker_status_change, absence_balance, benefit_election, performance_rating, business_process_txn, training_completion, certification, engagement_score, requisition_pipeline, candidate_application, offer, workforce_monthly_snapshot" vertex="1">
          <mxGeometry height="100" width="255" x="585" y="852" as="geometry" />
