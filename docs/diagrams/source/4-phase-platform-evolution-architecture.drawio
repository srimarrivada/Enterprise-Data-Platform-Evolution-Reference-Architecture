        </mxCell>
        <UserObject label="" tooltip="After each batch: the MongoDB profile is rebuilt from curated, Tableau reads Hive over JDBC, and new-hire records are pushed to ServiceNow. Phase 3 adds near-real-time updates. Click for Phase 3." link="data:page/id,phase3" id="e7">
          <mxCell edge="1" parent="1" source="z4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0D9488;strokeWidth=2;endArrow=blockThin;endFill=1;flowAnimation=1;exitX=0.5;exitY=1;entryX=0.164;entryY=0;" target="srv">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" tooltip="The portal reads one profile document per page through a REST API in front of MongoDB. In Phase 3 the same profile is updated within seconds of a Workday event. Click for Phase 3." link="data:page/id,phase3" id="e8">
          <mxCell edge="1" parent="1" source="v1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0D9488;strokeWidth=2;endArrow=blockThin;endFill=1;flowAnimation=1;" target="hr">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="orch" parent="0" value="Orchestration" />
        <UserObject label="&lt;b&gt;ORCHESTRATION: Apache Airflow&lt;/b&gt;&lt;br&gt;DAGs generated from YAML | Dependencies inferred from configs | Daily 2:00 AM | Retries 3 | Resume from failed step&lt;br&gt;Teams + ServiceNow alerts | Full DQ suite after main batch | SLA 5:30 AM (design target)" tooltip="DAGs are generated from the same YAML manifests: one extraction task group per source, then zone-transition Spark jobs (including MPI), then serving refresh and export, then the full DQ suite. Re-runs are idempotent (watermarks and run log)." id="air">
          <mxCell parent="orch" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=2;shadow=1;fontSize=11;fontColor=#7C2D12;" vertex="1">
            <mxGeometry height="80" width="760" x="90" y="1564" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="① Trigger extraction&lt;div&gt;(per YAML manifest)&lt;/div&gt;" tooltip="One extraction task group per source (4), generated from the YAML manifests and run in parallel. Retries 3 times; watermarks are saved only after landing. Click for the Phase 2 code." link="https://github.com/srimarrivada/Enterprise-Data-Platform-Evolution-Reference-Implementation/tree/main/phase2-multi-source" id="o1">
          <mxCell edge="1" parent="orch" source="air" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;dashPattern=6 4;strokeColor=#EA580C;strokeWidth=1.5;endArrow=open;endFill=0;fontSize=10;fontColor=#C2410C;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.8;entryX=1;entryY=0.5;" target="ext">
            <mxGeometry relative="1" x="0.5" as="geometry">
              <mxPoint as="offset" />
              <Array as="points">
                <mxPoint x="910" y="1628" />
                <mxPoint x="910" y="385" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="② Run PySpark zone jobs&lt;div&gt;+ MPI + DQ gate&lt;/div&gt;" tooltip="Landing → Raw → MPI → Curated → Consumption, in the order inferred from the configs. A failed blocking check stops the run; a re-run resumes from the failed step. Click for the Phase 2 code." link="https://github.com/srimarrivada/Enterprise-Data-Platform-Evolution-Reference-Implementation/tree/main/phase2-multi-source" id="o2">
          <mxCell edge="1" parent="orch" source="air" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;dashPattern=6 4;strokeColor=#EA580C;strokeWidth=1.5;endArrow=open;endFill=0;fontSize=10;fontColor=#C2410C;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" target="sto">
            <mxGeometry relative="1" x="0.2836" y="50" as="geometry">
              <mxPoint as="offset" />
              <Array as="points">
                <mxPoint x="890" y="1604" />
                <mxPoint x="890" y="780" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="③ Refresh Serving&lt;div&gt;+ Export&lt;/div&gt;" tooltip="Runs only after the zone jobs and DQ gate succeed: rebuilds the MongoDB profiles, refreshes Tableau and pushes new hires to ServiceNow. Click for the Phase 2 code." link="https://github.com/srimarrivada/Enterprise-Data-Platform-Evolution-Reference-Implementation/tree/main/phase2-multi-source" id="o3">
          <mxCell edge="1" parent="orch" source="air" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;dashPattern=6 4;strokeColor=#EA580C;strokeWidth=1.5;endArrow=open;endFill=0;fontSize=10;fontColor=#C2410C;fontStyle=1;labelBackgroundColor=#FFFFFF;entryX=1;entryY=0.5;">
            <mxGeometry relative="1" x="0.2559" y="30" as="geometry">
              <mxPoint as="offset" />
              <Array as="points">
                <mxPoint x="870" y="1580" />
                <mxPoint x="870" y="1198" />
              </Array>
              <mxPoint x="850" y="1573" as="sourcePoint" />
              <mxPoint x="850" y="1198" as="targetPoint" />
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="④ Full DQ suite (post-batch)" tooltip="All 9 check types run after the main batch. Results are stored in MongoDB; critical failures open a ServiceNow incident and warnings go to Teams. Click for the Phase 2 code." link="https://github.com/srimarrivada/Enterprise-Data-Platform-Evolution-Reference-Implementation/tree/main/phase2-multi-source" id="o4">
          <mxCell edge="1" parent="orch" source="air" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;dashPattern=6 4;strokeColor=#EA580C;strokeWidth=1.5;endArrow=open;endFill=0;fontSize=10;fontColor=#C2410C;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" target="dq">
