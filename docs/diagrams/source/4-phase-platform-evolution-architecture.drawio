          <mxGeometry height="130" width="930" x="90" y="140" as="geometry" />
        </mxCell>
        <mxCell id="s1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D97706;strokeWidth=1.5;shadow=1;fontSize=10;fontColor=#1E293B;" value="&lt;b&gt;Workday HCM&lt;/b&gt;&lt;br&gt;Batch - Daily&lt;br&gt;8 SOAP APIs + 10 Custom Reports + 1 RaaS&lt;br&gt;Incremental daily + Full weekly" vertex="1">
          <mxGeometry height="80" width="170" x="105" y="175" as="geometry" />
        </mxCell>
        <mxCell id="s2" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D97706;strokeWidth=1.5;shadow=1;fontSize=10;fontColor=#1E293B;" value="&lt;b&gt;Learning Platform&lt;/b&gt;&lt;br&gt;Batch - Daily&lt;br&gt;REST + OAuth 2.0 + JSON" vertex="1">
          <mxGeometry height="80" width="170" x="288" y="175" as="geometry" />
        </mxCell>
        <mxCell id="s3" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D97706;strokeWidth=1.5;shadow=1;fontSize=10;fontColor=#1E293B;" value="&lt;b&gt;Survey Platform&lt;/b&gt;&lt;br&gt;Batch - Daily&lt;br&gt;SFTP + CSV" vertex="1">
          <mxGeometry height="80" width="170" x="471" y="175" as="geometry" />
        </mxCell>
        <mxCell id="s4" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D97706;strokeWidth=1.5;shadow=1;fontSize=10;fontColor=#1E293B;" value="&lt;b&gt;Workday Recruiting&lt;/b&gt;&lt;br&gt;Batch - Daily&lt;br&gt;1 RaaS + 2 Custom Reports" vertex="1">
          <mxGeometry height="80" width="170" x="654" y="175" as="geometry" />
        </mxCell>
        <UserObject label="&lt;b&gt;Workday BPN&lt;/b&gt;&lt;br&gt;Real-time Events&lt;br&gt;5 event types (hire, terminate, job change, comp change, org assignment)" tooltip="Business Process Notifications pushed as HTTPS POST (JSON) with OAuth 2.0 bearer token. Workday retries on timeout, so duplicate deliveries are expected." id="s5">
          <mxCell parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#7C3AED;strokeWidth=2;shadow=1;fontSize=10;fontColor=#1E293B;" vertex="1">
            <mxGeometry height="80" width="170" x="837" y="175" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="bat" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#CA8A04;verticalAlign=top;align=center;spacingLeft=12;spacingTop=4;fontSize=13;fontStyle=1;fontColor=#A16207;" value="BATCH LAYER: On-premises (Source of truth)" vertex="1">
          <mxGeometry height="330" width="420" x="90" y="310" as="geometry" />
        </mxCell>
        <mxCell id="b1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CA8A04;strokeWidth=1.5;shadow=1;fontSize=11;fontColor=#1E293B;" value="&lt;b&gt;Python Extraction Framework&lt;/b&gt;&lt;br&gt;4 batch sources | YAML manifests" vertex="1">
          <mxGeometry height="50" width="380" x="110" y="350" as="geometry" />
        </mxCell>
        <mxCell id="b2" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CA8A04;strokeWidth=1.5;shadow=1;fontSize=10;fontColor=#1E293B;align=left;spacingLeft=10;" value="&lt;b&gt;HDFS (4 zones) + Hive Metastore&lt;/b&gt;&lt;br&gt;PySpark transforms&lt;div&gt;14 dims / 15 facts, MPI&lt;br&gt;Blocking DQ gate before consumption&lt;br&gt;Tableau batch dashboards&lt;br&gt;Daily 2:00 AM&lt;div&gt;SLA 5:30 AM (design target)&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="380" x="110" y="510" as="geometry" />
        </mxCell>
        <mxCell id="ing" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#16A34A;verticalAlign=top;align=center;spacingLeft=12;spacingTop=4;fontSize=13;fontStyle=1;fontColor=#15803D;" value="REAL-TIME INGESTION: On-premises" vertex="1">
          <mxGeometry height="330" width="460" x="560" y="310" as="geometry" />
        </mxCell>
        <UserObject label="&lt;b&gt;Webhook receiver:&lt;/b&gt; Python Flask + nginx&lt;br&gt;• OAuth token validation&lt;br&gt;• JSON payload parsing&lt;br&gt;• Redis dedup check (5-min TTL)&lt;br&gt;• Route to Kafka topic; acknowledge Workday within 3 s" tooltip="Design decision: acknowledge fast, process async. Redis SETNX on event_id drops most duplicate deliveries from Workday retries. Redis is a first filter, not the guarantee: every sink is idempotent on event_id, so a duplicate that gets past Redis changes nothing." id="wh">
          <mxCell parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=1.5;shadow=1;fontSize=10;fontColor=#1E293B;align=left;spacingLeft=10;" vertex="1">
            <mxGeometry height="100" width="420" x="580" y="350" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;Apache Kafka:&lt;/b&gt; 3 brokers, RF=3, 7-day retention&lt;br&gt;topics (key = emp_id): workday.hire, workday.term, workday.job_change, workday.comp_change, workday.org_change" tooltip="emp_id as partition key keeps each employee&#39;s events in order within a topic. Kafka does not order events across topics (e.g. hire vs job change), so the sinks apply events by event timestamp: the newer event wins and older ones are ignored. 7-day retention allows replay after downstream outages; the Delta archive covers replay beyond that." id="kf">
          <mxCell parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=1.5;shadow=1;fontSize=10;fontColor=#1E293B;align=left;spacingLeft=10;" vertex="1">
            <mxGeometry height="100" width="420" x="580" y="520" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="spd" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#7C3AED;verticalAlign=top;align=center;spacingLeft=12;spacingTop=4;fontSize=13;fontStyle=1;fontColor=#6D28D9;" value="SPEED LAYER: Azure Cloud (Low latency)" vertex="1">
          <mxGeometry height="330" width="460" x="560" y="700" as="geometry" />
        </mxCell>
        <UserObject label="&lt;b&gt;Spark Structured Streaming&lt;/b&gt; (Azure Databricks)&lt;div&gt;• Reads Kafka over ExpressRoute&lt;br&gt;• 30-second trigger; foreachBatch&lt;br&gt;• At-least-once; idempotent writes to 3 sinks (keyed on event_id)&lt;/div&gt;" tooltip="Delivery is at-least-once: after a failure, the last micro-batch is replayed from the checkpoint. Every sink is idempotent on event_id (Cassandra upsert by primary key, MongoDB update guarded by event time, Delta MERGE), so replays do not double-apply events. Checkpoints in ADLS." id="sp">
          <mxCell parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7C3AED;strokeWidth=1.5;shadow=1;fontSize=10;fontColor=#1E293B;align=left;spacingLeft=10;" vertex="1">
            <mxGeometry height="110" width="420" x="580" y="740" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="k1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7C3AED;strokeWidth=1.5;shadow=1;fontSize=9;fontColor=#1E293B;" value="&lt;b&gt;Cassandra&lt;/b&gt;&lt;br&gt;Azure VMs | 3 nodes | RF=3&lt;br&gt;90-day TTL&lt;br&gt;PK emp_id | CK event_dt DESC, event_id" vertex="1">
          <mxGeometry height="115" width="130" x="580" y="895" as="geometry" />
        </mxCell>
        <mxCell id="k2" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7C3AED;strokeWidth=1.5;shadow=1;fontSize=9;fontColor=#1E293B;" value="&lt;b&gt;MongoDB&lt;/b&gt;&lt;br&gt;On-prem via ExpressRoute&lt;br&gt;$set profile fields&lt;br&gt;guarded by event time (newer wins)" vertex="1">
          <mxGeometry height="115" width="130" x="725" y="895" as="geometry" />
        </mxCell>
        <mxCell id="k3" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7C3AED;strokeWidth=1.5;shadow=1;fontSize=9;fontColor=#1E293B;" value="&lt;b&gt;ADLS Delta Lake&lt;/b&gt;&lt;br&gt;Archive of all events&lt;br&gt;MERGE on event_id&lt;br&gt;Replay beyond Kafka retention" vertex="1">
          <mxGeometry height="115" width="130" x="870" y="895" as="geometry" />
        </mxCell>
        <UserObject label="&lt;b&gt;RECONCILIATION&lt;/b&gt;&lt;div&gt;(runs after batch completes)&lt;br&gt;&lt;br&gt;1. Batch rebuild sets the profile &lt;b&gt;floor&lt;/b&gt; (state at the extraction watermark)&lt;br&gt;2. Query Cassandra for events after the watermark&lt;br&gt;3. Re-apply them to MongoDB (idempotent, newer wins)&lt;br&gt;4. Verify final state = batch floor + newer events&lt;/div&gt;" tooltip="Design decision: batch remains the source of truth. Events up to the extraction watermark are already in the batch, so only later events are re-applied. This stops the nightly rebuild from overwriting fresher real-time updates. Differences found in step 4 are logged and alerted." id="rec">
          <mxCell parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#E11D48;strokeWidth=2;shadow=1;fontSize=10;fontColor=#1E293B;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;" vertex="1">
            <mxGeometry height="170" width="390" x="90" y="860" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="srv" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F0FDFA;strokeColor=#0D9488;verticalAlign=top;align=center;spacingLeft=12;spacingTop=4;fontSize=13;fontStyle=1;fontColor=#0F766E;" value="SERVING: Unified Consumption" vertex="1">
          <mxGeometry height="170" width="930" x="90" y="1070" as="geometry" />
        </mxCell>
        <mxCell id="v1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0D9488;strokeWidth=1.5;shadow=1;fontSize=10;fontColor=#1E293B;" value="&lt;b&gt;MongoDB:&lt;/b&gt; Complete profile&lt;br&gt;Batch + Real-time merged&lt;br&gt;→ HRBP Portal + ServiceNow" vertex="1">
          <mxGeometry height="115" width="280" x="115" y="1105" as="geometry" />
        </mxCell>
        <mxCell id="v2" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0D9488;strokeWidth=1.5;shadow=1;fontSize=10;fontColor=#1E293B;" value="&lt;b&gt;Cassandra:&lt;/b&gt; Recent events&lt;br&gt;Last 90 days&lt;br&gt;→ Real-time ops dashboard" vertex="1">
          <mxGeometry height="115" width="280" x="420" y="1105" as="geometry" />
        </mxCell>
        <mxCell id="v3" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0D9488;strokeWidth=1.5;shadow=1;fontSize=10;fontColor=#1E293B;" value="&lt;b&gt;Hive + Tableau:&lt;/b&gt; History&lt;br&gt;Batch-updated daily&lt;br&gt;→ Historical analytics" vertex="1">
          <mxGeometry height="115" width="280" x="725" y="1105" as="geometry" />
        </mxCell>
        <UserObject label="Batch pull (4 sources)" tooltip="The same four batch sources and YAML-driven framework as Phase 2, unchanged. Batch stays on-prem and remains the source of truth. Click for Phase 2." link="data:page/id,phase2" id="e1">
          <mxCell edge="1" parent="1" source="src" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#A16207;strokeWidth=2;endArrow=blockThin;endFill=1;flowAnimation=1;fontSize=10;fontColor=#475569;labelBackgroundColor=#FFFFFF;exitX=0.226;exitY=1;entryX=0.5;entryY=0;" target="bat">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" tooltip="Payloads land exactly as received. The extraction watermark recorded here is what reconciliation uses later as the cut-off between batch and stream. Click for the zone contracts." link="data:page/id,dataflow" id="e2">
          <mxCell edge="1" parent="1" source="b1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#A16207;strokeWidth=1.5;endArrow=blockThin;endFill=1;flowAnimation=1;exitX=0.106;exitY=1;entryX=0.5;entryY=0;" target="bz1">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" tooltip="Bi-directional HTTPS push from Workday. The receiver validates the OAuth token, acknowledges within 3 s and drops most retried duplicates with Redis before producing to Kafka. Click for ADR-0008." link="https://github.com/srimarrivada/Enterprise-Data-Platform-Evolution-Reference-Architecture/blob/main/docs/adr/0008-webhook-dedup-redis.md" id="e6">
          <mxCell edge="1" parent="1" source="s5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7C3AED;strokeWidth=2;endArrow=blockThin;endFill=1;flowAnimation=1;fontSize=10;fontColor=#6D28D9;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.814;entryY=0;" target="wh">
            <mxGeometry relative="1" x="-0.2639" as="geometry">
              <mxPoint as="offset" />
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="produce (key = emp_id)" tooltip="One topic per event type, keyed on emp_id, so each employee&#39;s events stay in order within a topic. Order across topics is handled by the sinks using event time. Click for the ADRs." link="https://github.com/srimarrivada/Enterprise-Data-Platform-Evolution-Reference-Architecture/tree/main/docs/adr" id="e7">
          <mxCell edge="1" parent="1" source="wh" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7C3AED;strokeWidth=2;endArrow=blockThin;endFill=1;flowAnimation=1;fontSize=10;fontColor=#6D28D9;labelBackgroundColor=#F0FDF4;" target="kf">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="ExpressRoute (private, low latency)" tooltip="Databricks in Azure consumes the on-prem Kafka topics over a private ExpressRoute link; no event data crosses the public internet. Checkpoints are stored in ADLS. Click for the Phase 3 code." link="https://github.com/srimarrivada/Enterprise-Data-Platform-Evolution-Reference-Implementation/tree/main/phase3-lambda-realtime" id="e8">
          <mxCell edge="1" parent="1" source="kf" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2563EB;strokeWidth=3;endArrow=blockThin;endFill=1;flowAnimation=1;fontSize=10;fontStyle=1;fontColor=#1D4ED8;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" target="sp">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" tooltip="Every event is upserted by primary key (emp_id, event_dt, event_id), so a replay writes the same row again. Rows expire after 90 days. Phase 4 plans to replace Cassandra with a Delta event table (ADR-0012). Click for the ADRs." link="https://github.com/srimarrivada/Enterprise-Data-Platform-Evolution-Reference-Architecture/tree/main/docs/adr" id="e9">
          <mxCell edge="1" parent="1" source="sp" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7C3AED;strokeWidth=2;endArrow=blockThin;endFill=1;flowAnimation=1;exitX=0.15;exitY=1;entryX=0.5;entryY=0;" target="k1">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" tooltip="Only the affected profile fields are updated with $set, and only if the event is newer than what the profile already holds. A late or replayed event changes nothing. Click for the Phase 3 code." link="https://github.com/srimarrivada/Enterprise-Data-Platform-Evolution-Reference-Implementation/tree/main/phase3-lambda-realtime" id="e10">
          <mxCell edge="1" parent="1" source="sp" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7C3AED;strokeWidth=2;endArrow=blockThin;endFill=1;flowAnimation=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" target="k2">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" tooltip="Every event is archived to Delta with MERGE on event_id, so duplicates are written once. The archive allows replay beyond Kafka&#39;s 7-day retention and becomes the basis for Phase 4. Click for ADR-0010." link="https://github.com/srimarrivada/Enterprise-Data-Platform-Evolution-Reference-Architecture/blob/main/docs/adr/0010-delta-over-hive-parquet.md" id="e11">
          <mxCell edge="1" parent="1" source="sp" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7C3AED;strokeWidth=2;endArrow=blockThin;endFill=1;flowAnimation=1;exitX=0.85;exitY=1;entryX=0.5;entryY=0;" target="k3">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Batch complete + watermark" tooltip="When the batch finishes, it passes its extraction watermark to reconciliation. Everything up to that point is already in the batch rebuild, which becomes the floor. Click for the Phase 3 code." link="https://github.com/srimarrivada/Enterprise-Data-Platform-Evolution-Reference-Implementation/tree/main/phase3-lambda-realtime" id="e12">
          <mxCell edge="1" parent="1" source="bat" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#A16207;strokeWidth=2;endArrow=blockThin;endFill=1;flowAnimation=1;fontSize=10;fontColor=#475569;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.538;entryY=0;" target="rec">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Events after&lt;div&gt;watermark&lt;/div&gt;" tooltip="Reconciliation reads only the events newer than the batch watermark from Cassandra and re-applies them to the rebuilt profile, newer event wins. Click for the Phase 3 code." link="https://github.com/srimarrivada/Enterprise-Data-Platform-Evolution-Reference-Implementation/tree/main/phase3-lambda-realtime" id="e13">
          <mxCell edge="1" parent="1" source="k1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7C3AED;strokeWidth=2;endArrow=blockThin;endFill=1;flowAnimation=1;fontSize=10;fontColor=#6D28D9;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=1;entryY=0.54;" target="rec">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" tooltip="After reconciliation, the MongoDB profile holds batch truth plus every newer event, and serves the HRBP portal and ServiceNow. In Phase 4 the profile moves to Cosmos DB. Click for Phase 4." link="data:page/id,phase4" id="e14">
          <mxCell edge="1" parent="1" source="rec" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0D9488;strokeWidth=2;endArrow=blockThin;endFill=1;flowAnimation=1;exitX=0.322;exitY=1;entryX=0.135;entryY=0;" target="srv">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" tooltip="Between batches, the speed layer keeps the profile and the 90-day event store current for the portal and the ops dashboard. In Phase 4, batch and stream run on one engine. Click for Phase 4." link="data:page/id,phase4" id="e15">
          <mxCell edge="1" parent="1" source="spd" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7C3AED;strokeWidth=2;endArrow=blockThin;endFill=1;flowAnimation=1;exitX=0.5;exitY=1;entryX=0.753;entryY=0;" target="srv">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="2UYWZkglcO4H28O-fGbe-2" connectable="0" parent="1" style="group" value="" vertex="1">
          <mxGeometry height="40" width="380" x="110" y="437" as="geometry" />
        </mxCell>
        <mxCell id="bz1" parent="2UYWZkglcO4H28O-fGbe-2" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#E2E8F0;strokeColor=#64748B;fontStyle=1;fontSize=9;" value="LANDING" vertex="1">
          <mxGeometry height="40" width="80.38043478260869" as="geometry" />
        </mxCell>
        <mxCell id="bz2" parent="2UYWZkglcO4H28O-fGbe-2" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#C2410C;fontStyle=1;fontSize=9;" value="RAW" vertex="1">
          <mxGeometry height="40" width="80.38043478260869" x="99.90217391304346" as="geometry" />
        </mxCell>
        <mxCell id="bz3" parent="2UYWZkglcO4H28O-fGbe-2" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#E5E7EB;strokeColor=#6B7280;fontStyle=1;fontSize=9;" value="CURATED" vertex="1">
          <mxGeometry height="40" width="80.38043478260869" x="198.77173913043472" as="geometry" />
        </mxCell>
        <mxCell id="bz4" parent="2UYWZkglcO4H28O-fGbe-2" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#CA8A04;fontStyle=1;fontSize=9;" value="CONSUMPTION" vertex="1">
          <mxGeometry height="40" width="81.32608695652173" x="298.67391304347825" as="geometry" />
        </mxCell>
        <UserObject label="" tooltip="Parse, flatten, type cast and dedup into source-aligned Parquet; rows that fail type casting go to a rejects table. Click for the zone contracts." link="data:page/id,dataflow" id="e3">
          <mxCell edge="1" parent="2UYWZkglcO4H28O-fGbe-2" source="bz1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#A16207;strokeWidth=1.5;endArrow=blockThin;endFill=1;flowAnimation=1;" target="bz2">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" tooltip="MPI, SCD Type 2 by content compare, unknown member for missing keys. Blocking DQ checks stop the load before Consumption. Click for the zone contracts." link="data:page/id,dataflow" id="e4">
          <mxCell edge="1" parent="2UYWZkglcO4H28O-fGbe-2" source="bz2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#A16207;strokeWidth=1.5;endArrow=blockThin;endFill=1;flowAnimation=1;" target="bz3">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" tooltip="Purpose-built aggregates for Tableau, rebuilt daily after the DQ gate passes. Click for the zone contracts." link="data:page/id,dataflow" id="e5">
          <mxCell edge="1" parent="2UYWZkglcO4H28O-fGbe-2" source="bz3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#A16207;strokeWidth=1.5;endArrow=blockThin;endFill=1;flowAnimation=1;" target="bz4">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="orch" parent="0" value="Orchestration" />
        <UserObject label="&lt;b&gt;ORCHESTRATION: Apache Airflow&lt;/b&gt;&lt;br&gt;DAGs generated from YAML | Dependencies inferred from configs | Daily 2:00 AM | Batch DAGs + reconciliation DAG + stream-health sensor&lt;br&gt;Retries 3 | Resume from failed step | Teams + ServiceNow alerts | SLA 5:30 AM (design target)" tooltip="Airflow runs the batch and reconciliation. It does not run the stream: the streaming job runs continuously on Databricks, and Airflow only checks its health and consumer lag. Re-runs are idempotent (watermarks and run log)." id="air">
          <mxCell parent="orch" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=2;shadow=1;fontSize=11;fontColor=#7C2D12;" vertex="1">
            <mxGeometry height="80" width="930" x="90" y="1285" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="① Run Batch&lt;div&gt;Extraction +&lt;/div&gt;&lt;div&gt;Zone Jobs&lt;/div&gt;" tooltip="Same batch DAGs as Phase 2: extraction per YAML manifest, then zone jobs with MPI and the blocking DQ gate. A re-run resumes from the failed step. Click for the Phase 3 code." link="https://github.com/srimarrivada/Enterprise-Data-Platform-Evolution-Reference-Implementation/tree/main/phase3-lambda-realtime" id="o1">
          <mxCell edge="1" parent="orch" source="air" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;dashPattern=6 4;strokeColor=#EA580C;strokeWidth=1.5;endArrow=open;endFill=0;fontSize=10;fontColor=#C2410C;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.35;entryX=0;entryY=0.5;" target="bat">
            <mxGeometry relative="1" x="0.2106" y="-8" as="geometry">
              <mxPoint as="offset" />
              <Array as="points">
                <mxPoint x="72" y="1313" />
                <mxPoint x="72" y="475" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="② Trigger Reconciliation&lt;div&gt;(after batch)&lt;/div&gt;" tooltip="Runs only after the batch succeeds, using its extraction watermark. Differences found in the verify step are logged and alerted to Teams and ServiceNow. Click for the Phase 3 code." link="https://github.com/srimarrivada/Enterprise-Data-Platform-Evolution-Reference-Implementation/tree/main/phase3-lambda-realtime" id="o2">
          <mxCell edge="1" parent="orch" source="air" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;dashPattern=6 4;strokeColor=#EA580C;strokeWidth=1.5;endArrow=open;endFill=0;fontSize=10;fontColor=#C2410C;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=0.341;exitY=0;entryX=0.813;entryY=1;" target="rec">
            <mxGeometry relative="1" x="-0.8039" as="geometry">
              <mxPoint as="offset" />
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="③ Refresh Serving" tooltip="Refreshes Tableau extracts and downstream exports after the batch and reconciliation. The profile and ops dashboard are already kept current by the stream. Click for the Phase 3 code." link="https://github.com/srimarrivada/Enterprise-Data-Platform-Evolution-Reference-Implementation/tree/main/phase3-lambda-realtime" id="o3">
          <mxCell edge="1" parent="orch" source="air" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;dashPattern=6 4;strokeColor=#EA580C;strokeWidth=1.5;endArrow=open;endFill=0;fontSize=10;fontColor=#C2410C;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" target="srv">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="④ Monitor Stream Health&lt;div&gt;+ Lag (always on)&lt;/div&gt;" tooltip="A sensor checks that the streaming job is running and that consumer lag stays within the threshold. Airflow does not start or stop the stream; it only alerts. Click for the Phase 3 code." link="https://github.com/srimarrivada/Enterprise-Data-Platform-Evolution-Reference-Implementation/tree/main/phase3-lambda-realtime" id="o4">
          <mxCell edge="1" parent="orch" source="air" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;dashPattern=6 4;strokeColor=#EA580C;strokeWidth=1.5;endArrow=open;endFill=0;fontSize=10;fontColor=#C2410C;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5625;entryX=1;entryY=0.5;" target="spd">
            <mxGeometry relative="1" x="0.181" y="20" as="geometry">
              <mxPoint as="offset" />
              <Array as="points">
                <mxPoint x="1050" y="1330" />
                <mxPoint x="1050" y="865" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <mxCell id="notes" parent="0" value="Annotations" />
        <UserObject label="REFERENCE ARCHITECTURE ↗" tooltip="Personal design exercise. Click to open the Phase 3 folder in the reference implementation repository." link="https://github.com/srimarrivada/Enterprise-Data-Platform-Evolution-Reference-Architecture/blob/main/docs/architecture/phase3-lambda.md" id="badge">
          <mxCell parent="notes" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#92400E;fontSize=11;fontStyle=1;" vertex="1">
            <mxGeometry height="60" width="190" x="870" y="20" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="bnd" edge="1" parent="notes" style="endArrow=none;html=1;dashed=1;dashPattern=10 6;strokeColor=#DC2626;strokeWidth=2;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="40" y="670" as="sourcePoint" />
            <mxPoint x="1080" y="670" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="bndt1" parent="notes" style="text;html=1;fontSize=11;fontStyle=1;fontColor=#DC2626;align=left;" value="▲ ON-PREMISES" vertex="1">
          <mxGeometry height="20" width="140" x="40" y="640" as="geometry" />
        </mxCell>
        <mxCell id="bndt2" parent="notes" style="text;html=1;fontSize=11;fontStyle=1;fontColor=#2563EB;align=right;" value="▼ AZURE CLOUD" vertex="1">
          <mxGeometry height="20" width="140" x="940" y="675" as="geometry" />
        </mxCell>
        <mxCell id="legend" parent="notes" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;dashed=1;align=center;verticalAlign=middle;spacing=6;fontSize=10;fontColor=#334155;" value="&lt;b&gt;LEGEND&lt;/b&gt;   &lt;font color=&quot;#A16207&quot;&gt;━━▶&lt;/font&gt; Batch flow   &lt;font color=&quot;#7C3AED&quot;&gt;━━▶&lt;/font&gt; Real-time stream   &lt;font color=&quot;#2563EB&quot;&gt;━━▶&lt;/font&gt; ExpressRoute   &lt;font color=&quot;#0D9488&quot;&gt;━━▶&lt;/font&gt; Serving   &lt;font color=&quot;#EA580C&quot;&gt;╍╍▶&lt;/font&gt; Orchestration (①–④)   &lt;font color=&quot;#DC2626&quot;&gt;┅┅&lt;/font&gt; Network boundary&lt;br&gt;&lt;i&gt;Lambda = Batch layer (truth) + Speed layer (low latency) + Reconciliation · Hover boxes and arrows for details; click arrows to open · Ctrl+Shift+L toggles layers&lt;/i&gt;" vertex="1">
          <mxGeometry height="55" width="930" x="90" y="1390" as="geometry" />
        </mxCell>
        <mxCell id="foot" parent="notes" style="text;html=1;whiteSpace=wrap;align=center;fontSize=10;fontStyle=2;fontColor=#64748B;" value="Personal reference architecture. Counts, TTLs and SLAs are design parameters, to be validated in the hands-on reference implementation (phase3-lambda-realtime). Hover an arrow to see what happens at that step; click it to open the related page or code." vertex="1">
          <mxGeometry height="30" width="930" x="90" y="1450" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
