        <mxCell id="f1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#4A044E;" value="✔ Searchable catalog with descriptions and owners&lt;br&gt;✔ Lineage from raw tables to product views&lt;br&gt;✔ PII masking + row filters inside product views (email, DOB, compensation, business unit)" vertex="1">
          <mxGeometry height="70" width="430" x="125" y="1087" as="geometry" />
        </mxCell>
        <mxCell id="f2" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#4A044E;" value="✔ Domain groups get SELECT on their product schema only; grants as versioned SQL&lt;br&gt;✔ Product tags (domain, owner, freshness target, PII)&lt;br&gt;✔ Audit logging (who accessed what, when)" vertex="1">
          <mxGeometry height="70" width="430" x="570" y="1087" as="geometry" />
        </mxCell>
        <mxCell id="srv" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F0FDFA;strokeColor=#0D9488;verticalAlign=top;align=center;spacingLeft=12;spacingTop=4;fontSize=13;fontStyle=1;fontColor=#0F766E;" value="SERVING: Operational Data Stores" vertex="1">
          <mxGeometry height="150" width="930" x="90" y="1210" as="geometry" />
        </mxCell>
        <mxCell id="cos" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0D9488;strokeWidth=1.5;shadow=1;fontSize=10;" value="&lt;b&gt;Azure Cosmos DB for MongoDB&lt;/b&gt; (serverless)&lt;br&gt;Wire-compatible · connection string change only&lt;br&gt;360° employee profile → HRBP Portal, ServiceNow" vertex="1">
          <mxGeometry height="100" width="330" x="200" y="1245" as="geometry" />
        </mxCell>
        <UserObject label="&lt;b&gt;Apache Cassandra&lt;/b&gt; (self-managed, interim)&lt;br&gt;3 nodes · RF=3 · 90-day TTL · written by the stream&lt;br&gt;Event store → ops dashboard&lt;br&gt;&lt;i&gt;Target: Delta event table (planned)&lt;/i&gt;" tooltip="Kept self-managed until a Delta event table (MERGE on event_id, queried by SQL) matches it in the stream demo. See ADR-0012." id="cas">
          <mxCell parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0D9488;strokeWidth=1.5;dashed=1;shadow=1;fontSize=10;" vertex="1">
            <mxGeometry height="100" width="330" x="580" y="1245" as="geometry" />
