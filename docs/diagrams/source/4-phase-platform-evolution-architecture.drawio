        <UserObject label="Docker: HDFS + Hive + Spark + Airflow" tooltip="Open phase1-batch-lake in the reference implementation" link="https://github.com/srimarrivada/Enterprise-Data-Platform-Evolution-Reference-Implementation/tree/main/phase1-batch-lake" id="r9a">
          <mxCell parent="1" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#EA580C;strokeWidth=2;fontSize=10;fontStyle=1;" vertex="1">
            <mxGeometry height="38" width="183" x="230" y="1105" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="+ MongoDB + SFTP + DQ engine" tooltip="Open phase2-multi-source in the reference implementation" link="https://github.com/srimarrivada/Enterprise-Data-Platform-Evolution-Reference-Implementation/tree/main/phase2-multi-source" id="r9b">
          <mxCell parent="1" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#EA580C;strokeWidth=2;fontSize=10;fontStyle=1;" vertex="1">
            <mxGeometry height="38" width="183" x="443" y="1105" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="+ Kafka + Cassandra + Redis" tooltip="Open phase3-lambda-realtime in the reference implementation" link="https://github.com/srimarrivada/Enterprise-Data-Platform-Evolution-Reference-Implementation/tree/main/phase3-lambda-realtime" id="r9c">
          <mxCell parent="1" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#EA580C;strokeWidth=2;fontSize=10;fontStyle=1;" vertex="1">
            <mxGeometry height="38" width="183" x="656" y="1105" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Databricks + Terraform + Unity Catalog" tooltip="Open phase4-azure-lakehouse in the reference implementation" link="https://github.com/srimarrivada/Enterprise-Data-Platform-Evolution-Reference-Implementation/tree/main/phase4-azure-lakehouse" id="r9d">
          <mxCell parent="1" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#EA580C;strokeWidth=2;fontSize=10;fontStyle=1;" vertex="1">
            <mxGeometry height="38" width="183" x="869" y="1105" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" tooltip="Same on-prem Hadoop cluster; MongoDB added as a 3-node replica set for the 360° profile. Click for Phase 2." link="data:page/id,phase2" id="r1e1">
          <mxCell edge="1" parent="1" source="r1a" style="endArrow=blockThin;endFill=1;strokeColor=#F97316;strokeWidth=2;html=1;flowAnimation=1;" target="r1b">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" tooltip="A speed layer is added in Azure (Databricks, Cassandra on VMs) over private ExpressRoute. Batch stays on-prem as the source of truth. Click for Phase 3." link="data:page/id,phase3" id="r1e2">
          <mxCell edge="1" parent="1" source="r1b" style="endArrow=blockThin;endFill=1;strokeColor=#F97316;strokeWidth=2;html=1;flowAnimation=1;" target="r1c">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" tooltip="Everything moves to Azure managed services with the same wire protocols; Cassandra stays self-managed until a Delta event table replaces it (ADR-0012). Click for the ADRs." link="https://github.com/srimarrivada/Enterprise-Data-Platform-Evolution-Reference-Architecture/tree/main/docs/adr" id="r1e3">
          <mxCell edge="1" parent="1" source="r1c" style="endArrow=blockThin;endFill=1;strokeColor=#F97316;strokeWidth=2;html=1;flowAnimation=1;" target="r1d">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" tooltip="Still batch only. Three sources are added to the same framework, plus the DQ framework: a blocking gate in the zone jobs and the full suite after the batch. Click for Phase 2." link="data:page/id,phase2" id="r2e1">
          <mxCell edge="1" parent="1" source="r2a" style="endArrow=blockThin;endFill=1;strokeColor=#F97316;strokeWidth=2;html=1;flowAnimation=1;" target="r2b">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" tooltip="Lambda over Kappa: Workday events flow through Kafka and Spark Structured Streaming for freshness, while batch stays the truth and reconciliation closes the gap. Click for Phase 3." link="data:page/id,phase3" id="r2e2">
          <mxCell edge="1" parent="1" source="r2b" style="endArrow=blockThin;endFill=1;strokeColor=#F97316;strokeWidth=2;html=1;flowAnimation=1;" target="r2c">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" tooltip="Batch and streaming run on one engine (Databricks) over Delta tables; reconciliation and the published snapshot keep them consistent. Click for Phase 4." link="data:page/id,phase4" id="r2e3">
          <mxCell edge="1" parent="1" source="r2c" style="endArrow=blockThin;endFill=1;strokeColor=#F97316;strokeWidth=2;html=1;flowAnimation=1;" target="r2d">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" tooltip="MongoDB is added as a document store, so the HRBP portal reads one document per employee. Click for Phase 2." link="data:page/id,phase2" id="r3e1">
          <mxCell edge="1" parent="1" source="r3a" style="endArrow=blockThin;endFill=1;strokeColor=#F97316;strokeWidth=2;html=1;flowAnimation=1;" target="r3b">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" tooltip="Delta is used first as the event archive (MERGE on event_id, replay beyond Kafka retention); Cassandra holds the 90-day event store. Click for Phase 3." link="data:page/id,phase3" id="r3e2">
          <mxCell edge="1" parent="1" source="r3b" style="endArrow=blockThin;endFill=1;strokeColor=#F97316;strokeWidth=2;html=1;flowAnimation=1;" target="r3c">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" tooltip="Delta Lake replaces Hive/Parquet in every zone: ACID MERGE for SCD2, time travel for restore, versions for the published snapshot. Click for ADR-0010." link="https://github.com/srimarrivada/Enterprise-Data-Platform-Evolution-Reference-Architecture/blob/main/docs/adr/0010-delta-over-hive-parquet.md" id="r3e3">
          <mxCell edge="1" parent="1" source="r3c" style="endArrow=blockThin;endFill=1;strokeColor=#F97316;strokeWidth=2;html=1;flowAnimation=1;" target="r3d">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" tooltip="Learning (REST), Survey (SFTP) and Recruiting (RaaS + custom reports) are added as YAML manifests; SFTP needs one new plugin. Click for Phase 2." link="data:page/id,phase2" id="r4e1">
          <mxCell edge="1" parent="1" source="r4a" style="endArrow=blockThin;endFill=1;strokeColor=#F97316;strokeWidth=2;html=1;flowAnimation=1;" target="r4b">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" tooltip="Workday BPN pushes events to a webhook receiver; Redis drops most duplicate deliveries before Kafka. Click for ADR-0008." link="https://github.com/srimarrivada/Enterprise-Data-Platform-Evolution-Reference-Architecture/blob/main/docs/adr/0008-webhook-dedup-redis.md" id="r4e2">
          <mxCell edge="1" parent="1" source="r4b" style="endArrow=blockThin;endFill=1;strokeColor=#F97316;strokeWidth=2;html=1;flowAnimation=1;" target="r4c">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" tooltip="Same sources. Kafka is replaced by the Event Hubs Kafka endpoint, so producers and consumers change connection settings only. Click for Phase 4." link="data:page/id,phase4" id="r4e3">
          <mxCell edge="1" parent="1" source="r4c" style="endArrow=blockThin;endFill=1;strokeColor=#F97316;strokeWidth=2;html=1;flowAnimation=1;" target="r4d">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" tooltip="5 dimensions and 7 facts added for the new domains, conformed on person_id from the Master Person Index. Click for Phase 2." link="data:page/id,phase2" id="r5e1">
          <mxCell edge="1" parent="1" source="r5a" style="endArrow=blockThin;endFill=1;strokeColor=#F97316;strokeWidth=2;html=1;flowAnimation=1;" target="r5b">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" tooltip="The star schema is unchanged; a 90-day event store is added for recent events and the ops dashboard. Click for Phase 3." link="data:page/id,phase3" id="r5e2">
          <mxCell edge="1" parent="1" source="r5b" style="endArrow=blockThin;endFill=1;strokeColor=#F97316;strokeWidth=2;html=1;flowAnimation=1;" target="r5c">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" tooltip="The star schema is unchanged. Domain data products are views over the published snapshot, not copies (ADR-0011). Click for the ADRs." link="https://github.com/srimarrivada/Enterprise-Data-Platform-Evolution-Reference-Architecture/tree/main/docs/adr" id="r5e3">
          <mxCell edge="1" parent="1" source="r5c" style="endArrow=blockThin;endFill=1;strokeColor=#F97316;strokeWidth=2;html=1;flowAnimation=1;" target="r5d">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" tooltip="The Phase 1 gate checks grow into a YAML-configured framework with 9 check types and alerts by severity. Click for Phase 2." link="data:page/id,phase2" id="r6e1">
          <mxCell edge="1" parent="1" source="r6a" style="endArrow=blockThin;endFill=1;strokeColor=#F97316;strokeWidth=2;html=1;flowAnimation=1;" target="r6b">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" tooltip="Reconciliation is added: the batch rebuild sets the floor, events newer than the watermark are re-applied, and the result is verified. Click for Phase 3." link="data:page/id,phase3" id="r6e2">
          <mxCell edge="1" parent="1" source="r6b" style="endArrow=blockThin;endFill=1;strokeColor=#F97316;strokeWidth=2;html=1;flowAnimation=1;" target="r6c">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" tooltip="Unity Catalog adds lineage, masks and row filters inside product views, and audit logs. Lakehouse checks alert; a failed check stops the published snapshot from advancing (ADR-0011). Click for the ADRs." link="https://github.com/srimarrivada/Enterprise-Data-Platform-Evolution-Reference-Architecture/tree/main/docs/adr" id="r6e3">
          <mxCell edge="1" parent="1" source="r6c" style="endArrow=blockThin;endFill=1;strokeColor=#F97316;strokeWidth=2;html=1;flowAnimation=1;" target="r6d">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" tooltip="Tableau dashboards on Hive, and a single-read 360° profile for HR business partners. Click for Phase 2." link="data:page/id,phase2" id="r7e1">
          <mxCell edge="1" parent="1" source="r7a" style="endArrow=blockThin;endFill=1;strokeColor=#F97316;strokeWidth=2;html=1;flowAnimation=1;" target="r7b">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" tooltip="The profile updates in near real time after a Workday event; an ops dashboard covers the last 90 days of events. Click for Phase 3." link="data:page/id,phase3" id="r7e2">
          <mxCell edge="1" parent="1" source="r7b" style="endArrow=blockThin;endFill=1;strokeColor=#F97316;strokeWidth=2;html=1;flowAnimation=1;" target="r7c">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" tooltip="Domain teams query their own products and build tables in their own workspaces, masked and filtered per reader. Click for Phase 4." link="data:page/id,phase4" id="r7e3">
          <mxCell edge="1" parent="1" source="r7c" style="endArrow=blockThin;endFill=1;strokeColor=#F97316;strokeWidth=2;html=1;flowAnimation=1;" target="r7d">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" tooltip="Same cluster, plus MongoDB servers for the profile store. Click for Phase 2." link="data:page/id,phase2" id="r8e1">
