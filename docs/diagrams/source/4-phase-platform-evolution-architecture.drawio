        <mxCell id="con" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#4F46E5;verticalAlign=top;align=center;spacingLeft=12;spacingTop=4;fontSize=13;fontStyle=1;fontColor=#4338CA;" value="CONSUMPTION: Analytics + Operational Consumers" vertex="1">
